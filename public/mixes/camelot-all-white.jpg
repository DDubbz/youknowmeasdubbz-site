<svg viewBox="0 0 1200 1200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="1200" height="1200" fill="#0F0F1A"/>
  <!-- Background glow -->
  <circle cx="600" cy="600" r="500" fill="#00D4FF" opacity="0.08"/>
  <circle cx="600" cy="600" r="300" fill="#FFD700" opacity="0.05"/>
  
  <!-- Central vinyl record -->
  <circle cx="600" cy="600" r="320" fill="#1A1A2E" stroke="#00D4FF" stroke-width="4"/>
  <circle cx="600" cy="600" r="280" fill="#0F0F1A" stroke="#333344" stroke-width="2"/>
  <circle cx="600" cy="600" r="80" fill="#00D4FF"/>
  <circle cx="600" cy="600" r="40" fill="#0F0F1A"/>
  <circle cx="600" cy="600" r="80" fill="none" stroke="#00D4FF" stroke-width="2" stroke-dasharray="31.4" opacity="0.3"/>
  
  <!-- Title text -->
  <text x="600" y="980" font-family="Bebas Neue, Montserrat, sans-serif" font-size="72" font-weight="400" fill="#FFFFFF" text-anchor="middle" letter-spacing="0.05em">CAMELOT YACHT CLUB</text>
  <text x="600" y="1050" font-family="Bebas Neue, Montserrat, sans-serif" font-size="48" font-weight="400" fill="#00D4FF" text-anchor="middle" letter-spacing="0.1em">ALL WHITE PARTY</text>
  
  <!-- Date -->
  <text x="600" y="1120" font-family="Montserrat, sans-serif" font-size="28" fill="#8888AA" text-anchor="middle">09.06.2024</text>
  
  <!-- Genre tags -->
  <g font-family="Bebas Neue, Montserrat, sans-serif" font-size="20" fill="#00D4FF" text-anchor="middle">
    <text x="600" y="1160">HIP-HOP  •  R&B  •  DANCEHALL  •  KOMPA  •  TRAP  •  BOUNCE</text>
  </g>
  
  <!-- Duration badge -->
  <rect x="500" y="100" width="200" height="50" rx="25" fill="#00D4FF" opacity="0.9"/>
  <text x="600" y="132" font-family="Bebas Neue, Montserrat, sans-serif" font-size="24" fill="#0F0F1A" text-anchor="middle">6:53:00</text>
  
  <!-- Track count badge -->
  <rect x="500" y="1050" width="200" height="40" rx="20" fill="#FFD700" opacity="0.9"/>
  <text x="600" y="1078" font-family="Bebas Neue, Montserrat, sans-serif" font-size="20" fill="#0F0F1A" text-anchor="middle">125 TRACKS</text>
</svg>