---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  section?: string;
  tags?: string[];
  faqItems?: Array<{ question: string; answer: string }>;
  showReviews?: boolean;
  noindex?: boolean;
}
const { title, description, ogImage, ogType = 'website', publishedTime, modifiedTime, author, section, tags, faqItems, showReviews = true, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://youknowmeasdubbz.com').toString();
const defaultOgImage = ogImage || 'https://youknowmeasdubbz.com/og-home.jpg';
const currentYear = new Date().getFullYear();
const fullTitle = title.includes('You Know Me As Dubbz') ? title : `${title} | You Know Me As Dubbz`;

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://youknowmeasdubbz.com/" },
  ...pathParts.map((part, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name: part.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),
    item: `https://youknowmeasdubbz.com/${pathParts.slice(0, index + 1).join('/')}/`
  }))
];

const jsonLd: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://youknowmeasdubbz.com/#business",
      "name": "You Know Me As Dubbz",
      "alternateName": ["Dubbz", "DWBEATBEAST"],
      "url": "https://youknowmeasdubbz.com/",
      "logo": { "@type": "ImageObject", "url": "https://youknowmeasdubbz.com/favicon.svg" },
      "image": "https://youknowmeasdubbz.com/og-home.jpg",
      "description": "West Palm Beach DJ and event entertainment business serving corporate events, weddings, nightlife, and private parties across South Florida.",
      "sameAs": [
        "https://instagram.com/youknowmeasdubbz",
        "https://tiktok.com/@youknowmeasdubbz",
        "https://soundcloud.com/youknowmeasdubbz",
        "https://www.youtube.com/@youknowmeasdubbz",
        "https://www.mixcloud.com/YouKnowMeAsDubbz/"
      ],
      "email": "dj@youknowmeasdubbz.com",
      "telephone": "+1-305-902-2698",
      "address": { "@type": "PostalAddress", "addressLocality": "West Palm Beach", "addressRegion": "FL", "addressCountry": "US" },
      "areaServed": { "@type": "AdministrativeArea", "name": "South Florida" },
      "knowsAbout": ["Corporate event entertainment", "Open-format DJ sets", "MC services", "Clean music programming", "Event audio and lighting", "Wedding DJ services"]
    },
    {
      "@type": "WebSite",
      "@id": "https://youknowmeasdubbz.com/#website",
      "url": "https://youknowmeasdubbz.com/",
      "name": "You Know Me As Dubbz",
      "publisher": { "@id": "https://youknowmeasdubbz.com/#business" }
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://youknowmeasdubbz.com/#website" },
      "about": { "@id": "https://youknowmeasdubbz.com/#business" },
      "breadcrumb": { "@id": `${canonicalUrl}#breadcrumb` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": breadcrumbItems
    }
  ]
};

if (ogType === 'article' && publishedTime) {
  jsonLd["@graph"].push({
    "@type": "BlogPosting",
    "@id": `${canonicalUrl}#article`,
    "headline": title,
    "description": description,
    "datePublished": publishedTime,
    ...(modifiedTime ? { "dateModified": modifiedTime } : {}),
    "mainEntityOfPage": { "@id": `${canonicalUrl}#webpage` },
    "author": { "@id": "https://youknowmeasdubbz.com/#business" },
    "publisher": { "@id": "https://youknowmeasdubbz.com/#business" },
    "image": defaultOgImage,
    ...(section ? { articleSection: section } : {}),
    ...(tags ? { keywords: tags.join(', ') } : {})
  });
}

const profService: any = {
  "@type": "ProfessionalService",
  "@id": "https://youknowmeasdubbz.com/#dj-service",
  "name": "You Know Me As Dubbz",
  "alternateName": ["Dubbz", "DWBEATBEAST"],
  "url": "https://youknowmeasdubbz.com/",
  "parentOrganization": { "@id": "https://youknowmeasdubbz.com/#business" },
  "image": "https://youknowmeasdubbz.com/og-home.jpg",
  "email": "dj@youknowmeasdubbz.com",
  "telephone": "+1-305-902-2698",
  "address": { "@type": "PostalAddress", "addressLocality": "West Palm Beach", "addressRegion": "FL", "addressCountry": "US" },
  "areaServed": { "@type": "AdministrativeArea", "name": "South Florida" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "DJ and Event Services",
    "itemListElement": ["Corporate Event DJ", "Wedding DJ Services", "Private Event DJ", "MC Services", "Event Audio and Lighting"].map(name => ({
      "@type": "Offer", "itemOffered": { "@type": "Service", "name": name, "provider": { "@id": "https://youknowmeasdubbz.com/#business" } }
    }))
  }
};

if (showReviews) {
  profService.review = [
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Sarah & Marcus" },
      "reviewBody": "Dubbz read the room perfectly — our guests are still talking about the music three months later. The transition from dinner to dance floor was seamless, and he handled every request without losing the vibe. Worth every penny of our investment.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Jeanie Joseph" },
      "reviewBody": "We've booked Dubbz for multiple Friday nights now, and the energy is consistently on point. He knows how to build a crowd, keep them dancing, and wrap on time. Professional, reliable, and the music is always fresh.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Christian M." },
      "reviewBody": "Dubbz has become part of our Saturday night identity. Guests come back specifically for his sets — the way he blends R&B, dancehall, and afrobeats keeps the dance floor packed until close. He's easy to work with and always prepared.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    },
    {
      "@type": "Review",
      "author": { "@type": "Person", "name": "Private Client" },
      "reviewBody": "We wanted music that felt personal but didn't overpower the evening. Dubbz composed a mix that moved from cocktail hour through dinner to dancing — every transition felt intentional. Our guests asked for his info before the night was over.",
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
    }
  ];
}

jsonLd["@graph"].push(profService);

if (faqItems && faqItems.length > 0) {
  jsonLd["@graph"].push({
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": { "@type": "Answer", "text": item.answer }
    }))
  });
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Bebas+Neue&display=swap" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage || 'https://youknowmeasdubbz.com/og-home.jpg'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || 'https://youknowmeasdubbz.com/og-home.jpg'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {section && <meta property="article:section" content={section} />}
    {tags && tags.map(tag => <meta property="article:tag" content={tag} />)}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="lenis">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <script src="../scripts/lenis.js"></script>
  </body>
</html>
