      </div>

      <div class="footer-links">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/mixes">Mixes</a></li>
          <li><a href="/gigs">Gigs</a></li>
          <li><a href="/contact">Booking</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h4>Services</h4>
        <ul>
          <li><a href="/services#weddings">Weddings</a></li>
          <li><a href="/services#corporate">Corporate Events</a></li>
          <li><a href="/services#nightlife">Nightlife & Clubs</a></li>
          <li><a href="/services#production">Music Production</a></li>
