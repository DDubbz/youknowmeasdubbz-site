<style>
  .dubbz-illustration {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
  }
  
  /* Subtle breathing animation for the whole illustration */
  @keyframes breathe {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-4px) scale(1.002); }
  }
  
  /* Float animations for decorative elements */
  @keyframes floatSlow {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    33% { transform: translate(8px, -6px) rotate(2deg); }
    66% { transform: translate(-4px, 8px) rotate(-1deg); }
  }
  
  @keyframes floatMedium {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-6px, -10px) rotate(-3deg); }
  }
  
  @keyframes pulseSubtle {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.05); }
  }
  
  /* Apply animations if enabled */
  .dubbz-illustration.animate-on .torso-group,
  .dubbz-illustration.animate-on .head-group {
    animation: breathe 6s ease-in-out infinite;
    transform-origin: center 500px;
  }
  
  .dubbz-illustration.animate-on .float-1 { animation: floatSlow 12s ease-in-out infinite; }
  .dubbz-illustration.animate-on .float-2 { animation: floatMedium 10s ease-in-out infinite; }
  .dubbz-illustration.animate-on .float-3 { animation: floatSlow 14s ease-in-out infinite; }
  .dubbz-illustration.animate-on .float-4 { animation: floatMedium 11s ease-in-out infinite; }
  .dubbz-illustration.animate-on .float-5 { animation: floatSlow 13s ease-in-out infinite; }
  
  /* Headphone pulse */
  .dubbz-illustration.animate-on .earcup-left,
  .dubbz-illustration.animate-on .earcup-right {
    animation: pulseSubtle 3s ease-in-out infinite;
    transform-origin: center center;
  }
  
  .dubbz-illustration.animate-on .earcup-right { animation-delay: 1.5s; }
  
  /* Headband subtle bounce */
  .dubbz-illustration.animate-on .headband {
    animation: breathe 4s ease-in-out infinite;
    transform-origin: center 190px;
  }
  
  /* Cap subtle tilt */
  .dubbz-illustration.animate-on .cap-crown {
    animation: breathe 8s ease-in-out infinite;
    transform-origin: center 165px;
  }
  
  .dubbz-illustration.animate-on .cap-brim { animation-delay: 0.2s; }
  
  /* Eyebrow expression */
  @keyframes browRaise {
    0%, 90%, 100% { transform: translateY(0); }
    95% { transform: translateY(-3px); }
  }
  
  .dubbz-illustration.animate-on .eyebrow-left,
  .dubbz-illustration.animate-on .eyebrow-right {
    animation: browRaise 4s ease-in-out infinite;
    transform-origin: center center;
  }
  
  /* Mouth subtle */
  @keyframes smileBreathe {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(1.05); }
  }
  
  .dubbz-illustration.animate-on .mouth {
    animation: smileBreathe 5s ease-in-out infinite;
    transform-origin: center 375px;
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .dubbz-illustration * {
      animation: none !important;
    }
  }
  
  /* Hover interactions */
  .dubbz-illustration:hover .earcup-left,
  .dubbz-illustration:hover .earcup-right {
    filter: drop-shadow(0 0 12px #00D4FF) drop-shadow(0 0 24px #FFD700);
  }
  
  .dubbz-illustration:hover .gold-collar {
    filter: drop-shadow(0 0 8px #FFD700);
  }
  
  .dubbz-illustration:hover .headband {
    filter: drop-shadow(0 0 10px #00D4FF);
  }
</style>

<script>
  // Initialize animations
  document.addEventListener('DOMContentLoaded', () => {
    const illustration = document.querySelector('.dubbz-illustration');
    if (illustration && config.animate) {
      illustration.classList.add('animate-on');
      
      // Parallax on mouse move (subtle)
      let rafId = null;
      illustration.addEventListener('mousemove', (e) => {
        if (rafId) return;
        rafId = requestAnimationFrame(() => {
          const rect = illustration.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          const deltaX = (e.clientX - centerX) / centerX;
          const deltaY = (e.clientY - centerY) / centerY;
          
          // Apply subtle transform to groups
          const headGroup = illustration.querySelector('.head-group');
          const capGroup = illustration.querySelector('.cap-group');
          const headphonesGroup = illustration.querySelector('.headphones-group');
          const torsoGroup = illustration.querySelector('.torso-group');
          
          if (headGroup) headGroup.style.transform = `translate(${deltaX * 4}px, ${deltaY * 3}px)`;
          if (capGroup) capGroup.style.transform = `translate(${deltaX * 5}px, ${deltaY * 4}px)`;
          if (headphonesGroup) headphonesGroup.style.transform = `translate(${deltaX * 6}px, ${deltaY * 5}px)`;
          if (torsoGroup) torsoGroup.style.transform = `translate(${deltaX * 2}px, ${deltaY * 1}px)`;
          
          rafId = null;
        });
      });
      
      illustration.addEventListener('mouseleave', () => {
        const groups = ['.head-group', '.cap-group', '.headphones-group', '.torso-group'];
        groups.forEach(sel => {
          const el = illustration.querySelector(sel);
          if (el) el.style.transform = '';
        });
      });
    }
  });
</script>