---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact & Booking — You Know Me As Dubbz" description="Book You Know Me As Dubbz for your event. Fill out the inquiry form for weddings, corporate events, club nights, or private parties in South Florida.">
  <Header />

  <main id="main-content">
    <section class="section section-hero">
      <div class="container">
        <header class="page-header">
          <h1 class="page-title">Contact & Booking</h1>
          <p class="page-description">Ready to book You Know Me As Dubbz for your event? Fill out the form below and I'll get back to you within 24 hours with availability and a custom quote.</p>
        </header>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="contact-grid grid grid-2">
          <div class="contact-info">
            <h2>Let's Talk About Your Event</h2>
            <p class="contact-lead">Every event is unique. Share your vision, and I'll create a custom proposal tailored to your date, venue, and vibe.</p>

            <div class="contact-methods">
              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Email</h3>
                  <a href="mailto:book@youknowmeasdubbz.com">book@youknowmeasdubbz.com</a>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Phone / Text</h3>
                  <a href="tel:+1561XXXXXXX">561-XXX-XXXX</a>
                  <p class="method-note">Best for urgent inquiries</p>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Location</h3>
                  <p>West Palm Beach, FL</p>
                  <p>Serving all of South Florida</p>
                </div>
              </div>
            </div>

            <div class="social-links">
              <a href="https://instagram.com/youknowmeasdubbz" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="https://soundcloud.com/youknowmeasdubbz" target="_blank" rel="noopener" aria-label="SoundCloud">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 1.5c4.14 0 7.5 3.36 7.5 7.5S16.14 21 12 21 4.5 17.64 4.5 12 7.86 4.5 12 4.5zm0 13c-3.04 0-5.5-2.46-5.5-5.5S8.96 5.5 12 5.5s5.5 2.46 5.5 5.5-2.46 5.5-5.5 5.5z"></path>
                  <path d="M19.07 4.93A10 10 0 0 1 12 19.07 10 10 0 0 1 4.93 12 10 10 0 0 1 12 4.93z"></path>
                </svg>
              </a>
              <a href="https://youtube.com/@youknowmeasdubbz" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="contact-form-wrapper">
            <form id="booking-form" class="contact-form" action="https://formspree.io/f/your-form-id" method="POST">
              <input type="hidden" name="_next" value="/contact?success=true" />
              <input type="hidden" name="_subject" value="New Booking Inquiry - You Know Me As Dubbz" />

              <div class="form-row">
                <div class="form-group">
                  <label for="name">Full Name <span class="required">*</span></label>
                  <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" />
                </div>
                <div class="form-group">
                  <label for="email">Email <span class="required">*</span></label>
                  <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Phone <span class="required">*</span></label>
                  <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(561) XXX-XXXX" />
                </div>
                <div class="form-group">
                  <label for="event-date">Event Date <span class="required">*</span></label>
                  <input type="date" id="event-date" name="event_date" required />
                </div>
              </div>

              <div class="form-group">
                <label for="event-type">Event Type <span class="required">*</span></label>
                <select id="event-type" name="event_type" required>
                  <option value="">Select event type</option>
                  <option value="wedding">Wedding</option>
                  <option value="corporate">Corporate Event</option>
                  <option value="club">Club / Nightlife</option>
                  <option value="private">Private Party</option>
                  <option value="festival">Festival / Large Event</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="venue">Venue Name</label>
                  <input type="text" id="venue" name="venue" autocomplete="organization" placeholder="Venue name (if known)" />
                </div>
                <div class="form-group">
                  <label for="address">Venue Address</label>
                  <input type="text" id="address" name="address" autocomplete="street-address" placeholder="City, State" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="guest-count">Estimated Guest Count</label>
                  <select id="guest-count" name="guest_count">
                    <option value="">Select range</option>
                    <option value="1-50">1-50 guests</option>
                    <option value="51-100">51-100 guests</option>
                    <option value="101-200">101-200 guests</option>
                    <option value="201-300">201-300 guests</option>
                    <option value="301-500">301-500 guests</option>
                    <option value="500+">500+ guests</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="budget">Budget Range</label>
                  <select id="budget" name="budget">
                    <option value="">Select range</option>
                    <option value="1500-2500">$1,500 - $2,500</option>
                    <option value="2500-5000">$2,500 - $5,000</option>
                    <option value="5000-10000">$5,000 - $10,000</option>
                    <option value="10000+">$10,000+</option>
                    <option value="discuss">Let's discuss</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="services">Services Needed</label>
                <div class="checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="dj-only" />
                    <span>DJ Only</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="dj-mc" />
                    <span>DJ + MC / Hosting</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="production" />
                    <span>DJ + Production / Lighting</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="music-production" />
                    <span>Music Production (DWBEATBEAST)</span>
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label for="message">Message / Vision / Special Requests <span class="required">*</span></label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell me about your event vision, must-play songs, do-not-play list, special moments, theme, or any other details..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg btn-full">Send Inquiry</button>

              <p class="form-note">By submitting, you agree to be contacted about your inquiry. We never share your info.</p>
            </form>

            <!-- Success state -->
            <div id="form-success" class="form-success hidden">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <h3>Inquiry Sent!</h3>
              <p>Thanks for reaching out. I'll review your details and get back to you within 24 hours with availability and a custom quote.</p>
              <a href="/contact" class="btn btn-secondary">Send Another Inquiry</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-alt" aria-labelledby="faq-title">
      <div class="container">
        <h2 id="faq-title" class="section-title">Frequently Asked Questions</h2>
        <div class="faq-grid grid grid-2">
          <article class="faq-item card">
            <h3>How far in advance should I book?</h3>
            <p><strong>Weddings:</strong> 6-12 months recommended<br><strong>Corporate:</strong> 2-3 months<br><strong>Clubs/Private:</strong> 1-4 weeks</p>
          </article>
          <article class="faq-item card">
            <h3>Do you travel outside South Florida?</h3>
            <p>Yes, throughout Florida and destination events. Travel fees apply for extended/destination bookings.</p>
          </article>
          <article class="faq-item card">
            <h3>What's your cancellation policy?</h3>
            <p>Deposit is non-refundable. Full fee due 30 days prior. Force majeure clauses in contract for emergencies.</p>
          </article>
          <article class="faq-item card">
            <h3>Can I provide a do-not-play list?</h3>
            <p>Absolutely. We'll review it together during planning. Your vibe, your rules.</p>
          </article>
          <article class="faq-item card">
            <h3>Do you take requests during the event?</h3>
            <p>Yes, within the vibe/genre we agree on. Crowd-reading and requests are part of the art.</p>
          </article>
          <article class="faq-item card">
            <h3>Do you provide sound equipment?</h3>
            <p>Standard rider: CDJs + mixer. Sound system by venue or rented separately. Self-contained rig available for up to 300 pax.</p>
          </article>
          <article class="faq-item card">
            <h3>Can you MC / make announcements?</h3>
            <p>Yes, professional MC services included for weddings and private events. Corporate hosting available.</p>
          </article>
          <article class="faq-item card">
            <h3>What payment methods do you accept?</h3>
            <p>Venmo, Zelle, Check, Wire. Corporate: Net-30 invoicing available with PO.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .section-hero {
      padding: var(--space-20) 0 var(--space-12);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }

    .page-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }

    .contact-grid {
      gap: var(--space-12);
      align-items: start;
    }

    @media (max-width: 1024px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    .contact-lead {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      margin-bottom: var(--space-8);
    }

    .contact-methods {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      margin-bottom: var(--space-10);
    }

    .contact-method {
      display: flex;
      gap: var(--space-4);
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-3);
      transition: border-color var(--transition-fast);
    }

    .contact-method:hover {
      border-color: var(--color-accent);
    }

    .method-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--color-accent);
      color: var(--color-white);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .method-details h3 {
      font-size: var(--text-base);
      margin-bottom: var(--space-1);
    }

    .method-details a {
      color: var(--color-accent);
      font-weight: 500;
    }

    .method-note {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      margin-top: var(--space-1);
    }

    .social-links {
      display: flex;
      gap: var(--space-4);
    }

    .social-links a {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted);
      transition: all var(--transition-fast);
    }

    .social-links a:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-white);
      transform: translateY(-2px);
    }

    .contact-form-wrapper {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-4);
      padding: var(--space-8);
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    @media (max-width: 640px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .form-group label {
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-white);
    }

    .required {
      color: var(--color-accent);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: var(--space-3) var(--space-4);
      background: var(--color-primary);
      border: 1px solid var(--color-border);
      border-radius: var(--space-2);
      color: var(--color-white);
      font-family: var(--font-body);
      font-size: var(--text-base);
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(233, 69, 96, 0.15);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--color-gray-500);
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      cursor: pointer;
      font-size: var(--text-base);
      color: var(--color-text);
    }

    .checkbox-label input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--color-accent);
    }

    .btn-full {
      width: 100%;
    }

    .form-note {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      text-align: center;
      margin-top: var(--space-3);
    }

    .form-success {
      text-align: center;
      padding: var(--space-8);
    }

    .form-success svg {
      color: var(--color-accent);
      margin-bottom: var(--space-4);
    }

    .form-success h3 {
      margin-bottom: var(--space-2);
    }

    .form-success p {
      color: var(--color-text-muted);
      margin-bottom: var(--space-6);
    }

    .faq-grid {
      gap: var(--space-4);
    }

    .faq-item {
      padding: var(--space-5);
    }

    .faq-item h3 {
      font-size: var(--text-base);
      margin-bottom: var(--space-2);
    }

    .faq-item p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .btn-lg {
      padding: var(--space-4) var(--space-8);
      font-size: var(--text-lg);
    }
  </style>

  <script is:inline>
    // Handle form submission
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('booking-form');
      const successDiv = document.getElementById('form-success');

      // Check for success parameter
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('success') === 'true') {
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;

        try {
          const formData = new FormData(form);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            form.classList.add('hidden');
            successDiv.classList.remove('hidden');
            window.history.replaceState({}, '', '/contact?success=true');
          } else {
            throw new Error('Form submission failed');
          }
        } catch (err) {
          console.error('Form error:', err);
          alert('There was an error submitting the form. Please try again or email directly.');
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>