---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqItems = [
  {
    "question": "How far in advance should I book?",
    "answer": "For weddings, 9\u201312 months is ideal \u2014 prime Saturdays book first. Corporate events and club dates typically lock in 2\u20136 months ahead. Last-minute inquiries are always welcome; if the date is open, it's yours. A 50% deposit secures your date, and the balance is due 7 days before the event."
  },
  {
    "question": "Do you travel outside South Florida?",
    "answer": "Yes \u2014 destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end so you just get the date and the dance floor."
  },
  {
    "question": "What's your cancellation policy?",
    "answer": "The 50% deposit is non-refundable \u2014 it secures your date and covers advance planning. Full balance is due 7 days before the event. Force majeure clauses are included in the contract for genuine emergencies. Once the deposit lands, your date is locked and planning begins immediately."
  },
  {
    "question": "Can I provide a do-not-play list?",
    "answer": "Absolutely \u2014 your must-play and do-not-play lists are the foundation of every booking. We review them together during your planning consultation so there are no surprises on the night. Your vibe, your rules. The skill is honoring your boundaries while reading the room and keeping the dance floor moving."
  },
  {
    "question": "Do you take requests during the event?",
    "answer": "Yes, within the vibe and genre we agree on during planning. Crowd-reading is part of the art \u2014 knowing when a request fits and when it needs to wait. You set the boundaries with your must-play and do-not-play lists, and we handle the timing and flow throughout the night."
  },
  {
    "question": "Do you provide sound equipment?",
    "answer": "Our standard rider includes CDJs and a professional mixer. Sound systems are typically provided by the venue or can be rented separately for spaces without installed audio. A self-contained rig is available for up to 300 guests. Everything is tested on-site before guests arrive \u2014 setup and breakdown are handled entirely by us."
  },
  {
    "question": "Can you MC / make announcements?",
    "answer": "Yes \u2014 professional MC services are included for weddings and private events. Corporate hosting is also available. We coordinate with your planner and vendors to keep the timeline flowing: introductions, toasts, special dances, and any announcements are handled smoothly so you can be present in the moment."
  },
  {
    "question": "What payment methods do you accept?",
    "answer": "Venmo, Zelle, check, and wire transfer. For corporate bookings, Net-30 invoicing is available with a purchase order. The 50% deposit is due at booking to secure your date; the remaining balance is due 7 days before the event. Once the deposit lands, planning begins immediately."
  }
];
---

<BaseLayout title="Contact & Booking — You Know Me As Dubbz" description="Book You Know Me As Dubbz for your event. Fill out the inquiry form for weddings, corporate events, club nights, or private parties in South Florida." faqItems={faqItems}>
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- PAGE HERO -->
    <section class="section section-hero">
      <div class="container">
        <header class="page-header">
          <span class="page-greeting">LET'S WORK</span>
          <h1 class="page-title">Contact & Booking</h1>
          <p class="page-description">Ready to book You Know Me As Dubbz for your event? Fill out the form below and I'll get back to you within 24 hours with availability and a custom quote.</p>
        </header>
      </div>
    </section>

    <!-- CONTACT FORM & INFO -->
    <section class="section">
      <div class="container">
        <div class="contact-grid grid grid-2">
          <div class="contact-info panel">
            <h2>Let's Talk About Your Event</h2>
            <p class="contact-lead">Every event is unique. Share your vision, and I'll create a custom proposal tailored to your date, venue, and vibe.</p>

            <div class="contact-methods">
              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Email</h3>
                  <a href="mailto:dj@youknowmeasdubbz.com">dj@youknowmeasdubbz.com</a>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Phone / Text</h3>
                  <a href="tel:+13059022698">(305) 902-2698</a>
                  <p class="method-note">Best for urgent inquiries</p>
                </div>
              </div>

              <div class="contact-method">
                <div class="method-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <div class="method-details">
                  <h3>Location</h3>
                  <p>West Palm Beach, FL</p>
                  <p>Serving all of South Florida</p>
                </div>
              </div>
            </div>

            <div class="social-links">
              <a href="https://instagram.com/youknowmeasdubbz" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
              <a href="https://soundcloud.com/youknowmeasdubbz" target="_blank" rel="noopener" aria-label="SoundCloud">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 1.5c4.14 0 7.5 3.36 7.5 7.5S16.14 21 12 21 4.5 17.64 4.5 12 7.86 4.5 12 4.5zm0 13c-3.04 0-5.5-2.46-5.5-5.5S8.96 5.5 12 5.5s5.5 2.46 5.5 5.5-2.46 5.5-5.5 5.5z"></path>
                  <path d="M19.07 4.93A10 10 0 0 1 12 19.07 10 10 0 0 1 4.93 12 10 10 0 0 1 12 4.93z"></path>
                </svg>
              </a>
              <a href="https://youtube.com/@youknowmeasdubbz" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="contact-form-wrapper panel">
            <form id="booking-form" class="contact-form" action="https://formspree.io/f/meaqbjyd" method="POST">
              <input type="hidden" name="_next" value="/contact?success=true" />
              <input type="hidden" name="_subject" value="New Booking Inquiry - You Know Me As Dubbz" />

              <div class="form-row">
                <div class="form-group">
                  <label for="name">Full Name <span class="required">*</span></label>
                  <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" />
                </div>
                <div class="form-group">
                  <label for="email">Email <span class="required">*</span></label>
                  <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Phone <span class="required">*</span></label>
                  <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="(561) XXX-XXXX" />
                </div>
                <div class="form-group">
                  <label for="event-date">Event Date <span class="required">*</span></label>
                  <input type="date" id="event-date" name="event_date" required />
                </div>
              </div>

              <div class="form-group">
                <label for="event-type">Event Type <span class="required">*</span></label>
                <select id="event-type" name="event_type" required>
                  <option value="">Select event type</option>
                  <option value="wedding">Wedding</option>
                  <option value="corporate">Corporate Event</option>
                  <option value="club">Club / Nightlife</option>
                  <option value="private">Private Party</option>
                  <option value="festival">Festival / Large Event</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="venue">Venue Name</label>
                  <input type="text" id="venue" name="venue" autocomplete="organization" placeholder="Venue name (if known)" />
                </div>
                <div class="form-group">
                  <label for="address">Venue Address</label>
                  <input type="text" id="address" name="address" autocomplete="street-address" placeholder="City, State" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="guest-count">Estimated Guest Count</label>
                  <select id="guest-count" name="guest_count">
                    <option value="">Select range</option>
                    <option value="1-50">1-50 guests</option>
                    <option value="51-100">51-100 guests</option>
                    <option value="101-200">101-200 guests</option>
                    <option value="201-300">201-300 guests</option>
                    <option value="301-500">301-500 guests</option>
                    <option value="500+">500+ guests</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="budget">Budget Range</label>
                  <select id="budget" name="budget">
                    <option value="">Select range</option>
                    <option value="1500-2500">$1,500 - $2,500</option>
                    <option value="2500-5000">$2,500 - $5,000</option>
                    <option value="5000-10000">$5,000 - $10,000</option>
                    <option value="10000+">$10,000+</option>
                    <option value="discuss">Let's discuss</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="services">Services Needed</label>
                <div class="checkbox-group">
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="dj-only" />
                    <span>DJ Only</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="dj-mc" />
                    <span>DJ + MC / Hosting</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="production" />
                    <span>DJ + Production / Lighting</span>
                  </label>
                  <label class="checkbox-label">
                    <input type="checkbox" name="services" value="music-production" />
                    <span>Music Production (DWBEATBEAST)</span>
                  </label>
                </div>
              </div>

              <div class="form-group">
                <label for="message">Message / Vision / Special Requests <span class="required">*</span></label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell me about your event vision, must-play songs, do-not-play list, special moments, theme, or any other details..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-lg btn-full">Send Inquiry</button>

              <p class="form-note">By submitting, you agree to be contacted about your inquiry. We never share your info.</p>
            </form>

            <!-- Success state -->
            <div id="form-success" class="form-success hidden">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <h3>Inquiry Sent!</h3>
              <p>Thanks for reaching out. I'll review your details and get back to you within 24 hours with availability and a custom quote.</p>
              <a href="/contact" class="btn btn-secondary">Send Another Inquiry</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-alt contact-cta" aria-labelledby="faq-title">
      <div class="container">
        <header class="section-header">
          <h2 id="faq-title" class="section-title">Frequently Asked Questions</h2>
        </header>
        <div class="faq-grid">
          <details class="faq-item">
            <summary>How far in advance should I book?</summary>
            <p>For weddings, 9–12 months is ideal — prime Saturdays book first. Corporate events and club dates typically lock in 2–6 months ahead. Last-minute inquiries are always welcome; if the date is open, it’s yours. A 50% deposit secures your date, and the balance is due 7 days before the event.</p>
          </details>
          <details class="faq-item">
            <summary>Do you travel outside South Florida?</summary>
            <p>Yes — destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end so you just get the date and the dance floor.</p>
          </details>
          <details class="faq-item">
            <summary>What's your cancellation policy?</summary>
            <p>The 50% deposit is non-refundable — it secures your date and covers advance planning. Full balance is due 7 days before the event. Force majeure clauses are included in the contract for genuine emergencies. Once the deposit lands, your date is locked and planning begins immediately.</p>
          </details>
          <details class="faq-item">
            <summary>Can I provide a do-not-play list?</summary>
            <p>Absolutely — your must-play and do-not-play lists are the foundation of every booking. We review them together during your planning consultation so there are no surprises on the night. Your vibe, your rules. The skill is honoring your boundaries while reading the room and keeping the dance floor moving.</p>
          </details>
          <details class="faq-item">
            <summary>Do you take requests during the event?</summary>
            <p>Yes, within the vibe and genre we agree on during planning. Crowd-reading is part of the art — knowing when a request fits and when it needs to wait. You set the boundaries with your must-play and do-not-play lists, and we handle the timing and flow throughout the night.</p>
          </details>
          <details class="faq-item">
            <summary>Do you provide sound equipment?</summary>
            <p>Our standard rider includes CDJs and a professional mixer. Sound systems are typically provided by the venue or can be rented separately for spaces without installed audio. A self-contained rig is available for up to 300 guests. Everything is tested on-site before guests arrive — setup and breakdown are handled entirely by us.</p>
          </details>
          <details class="faq-item">
            <summary>Can you MC / make announcements?</summary>
            <p>Yes — professional MC services are included for weddings and private events. Corporate hosting is also available. We coordinate with your planner and vendors to keep the timeline flowing: introductions, toasts, special dances, and any announcements are handled smoothly so you can be present in the moment.</p>
          </details>
          <details class="faq-item">
            <summary>What payment methods do you accept?</summary>
            <p>Venmo, Zelle, check, and wire transfer. For corporate bookings, Net-30 invoicing is available with a purchase order. The 50% deposit is due at booking to secure your date; the remaining balance is due 7 days before the event. Once the deposit lands, planning begins immediately.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    #main-content {
      overflow: clip;
    }

    .section-hero {
      padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 96px);
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 82% 18%, rgba(0, 212, 255, 0.12), transparent 34%);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .contact-cta {
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 50% 0%, rgba(0, 212, 255, 0.10), transparent 40%);
    }

    .page-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .page-greeting {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: var(--space-4);
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
      align-items: start;
    }

    @media (max-width: 1024px) {
      .contact-grid {
        grid-template-columns: 1fr;
      }
    }

    .contact-lead {
      font-size: var(--text-lg);
      color: var(--color-text);
      margin-bottom: var(--space-8);
      font-weight: 500;
    }

    .contact-methods {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-bottom: var(--space-10);
    }

    .contact-method {
      display: flex;
      gap: var(--space-4);
      padding: var(--space-4);
      background: var(--color-primary);
      border: var(--outline-weight) solid var(--color-border);
      transition: all var(--transition-fast);
    }

    .contact-method:hover {
      border-color: var(--color-accent);
      transform: translateX(4px);
    }

    .method-icon {
      width: 48px;
      height: 48px;
      border: var(--outline-weight) solid var(--color-accent);
      background: var(--color-primary);
      color: var(--color-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .contact-method:hover .method-icon {
      background: var(--color-accent);
      color: var(--color-primary);
    }

    .method-details h3 {
      font-size: var(--text-base);
      margin-bottom: var(--space-1);
    }

    .method-details a {
      color: var(--color-accent);
      font-weight: 500;
    }

    .method-note {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      margin-top: var(--space-1);
    }

    .social-links {
      display: flex;
      gap: var(--space-4);
    }

    .social-links a {
      width: 44px;
      height: 44px;
      border: var(--outline-weight) solid var(--color-border);
      background: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted);
      transition: all var(--transition-fast);
    }

    .social-links a:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-primary);
      transform: translateY(-3px) translateX(-3px);
      box-shadow: var(--outline-weight) var(--outline-weight) 0 var(--color-border),
                  calc(var(--outline-weight) * 2) calc(var(--outline-weight) * 2) 0 var(--color-accent);
    }

    .contact-form-wrapper {
      padding: var(--space-8);
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }

    @media (max-width: 640px) {
      .form-row {
        grid-template-columns: 1fr;
      }
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .form-group label {
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-white);
    }

    .required {
      color: var(--color-accent);
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      padding: var(--space-3) var(--space-4);
      background: var(--color-primary);
      border: var(--outline-weight) solid var(--color-border);
      color: var(--color-white);
      font-family: var(--font-body);
      font-size: var(--text-base);
      transition: all var(--transition-fast);
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px var(--color-accent-dim);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: var(--color-gray-500);
    }

    .checkbox-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      cursor: pointer;
      font-size: var(--text-base);
      color: var(--color-text);
    }

    .checkbox-label input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--color-accent);
      border: 2px solid var(--color-border);
    }

    .btn-full {
      width: 100%;
    }

    .form-note {
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      text-align: center;
      margin-top: var(--space-3);
    }

    .form-success {
      text-align: center;
      padding: var(--space-8);
    }

    .form-success svg {
      color: var(--color-accent);
      margin-bottom: var(--space-4);
    }

    .form-success h3 {
      margin-bottom: var(--space-2);
    }

    .form-success p {
      color: var(--color-text-muted);
      margin-bottom: var(--space-6);
    }

    .faq-grid {
      gap: var(--space-4);
    }

    @media (max-width: 768px) {
      .faq-grid {
        grid-template-columns: 1fr;
      }
    }

    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-4);
      max-width: 900px;
      margin: 0 auto;
    }

    .faq-item {
      background: var(--color-surface);
      border: var(--outline-weight) solid var(--color-border);
      border-radius: 0;
      overflow: hidden;
    }

    .faq-item summary {
      padding: var(--space-5);
      cursor: pointer;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 400;
      color: var(--color-white);
      list-style: none;
      position: relative;
      padding-right: var(--space-10);
      transition: color var(--transition-fast);
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: '+';
      position: absolute;
      right: var(--space-5);
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-mono);
      font-size: var(--text-xl);
      color: var(--color-accent);
      transition: transform var(--transition-fast);
    }

    .faq-item[open] summary::after {
      transform: translateY(-50%) rotate(45deg);
    }

    .faq-item[open] summary {
      color: var(--color-accent);
    }

    .faq-item p {
      padding: 0 var(--space-5) var(--space-5);
      margin: 0;
      color: var(--color-text-muted);
      line-height: 1.7;
    }

    @media (max-width: 640px) {
      .faq-grid {
        grid-template-columns: 1fr;
      }
