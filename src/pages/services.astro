---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqItems = [
  {
    "question": "How far in advance should I book?",
    "answer": "For weddings, 9\u201312 months out is the sweet spot \u2014 prime Saturdays book first. Corporate events and club dates usually lock in 2\u20136 months ahead. Running late? Last-minute inquiries are always welcome; if the date's open, it's yours. Either way, the 50% deposit is what holds your date, not the inquiry."
  },
  {
    "question": "Do you take song requests?",
    "answer": "Absolutely \u2014 your must-play and do-not-play lists are the starting point, and guests can make requests on the night. The skill is honoring your taste while reading the room: if a request would clear the floor, it waits for the right moment. You set the boundaries; Dubbz handles the timing."
  },
  {
    "question": "What's included in a wedding package?",
    "answer": "Every wedding package starts at $1,500 and includes ceremony sound, cocktail hour, full reception DJing, wireless mics for speeches and toasts, custom playlist curation, timeline coordination with your planner, and all professional audio equipment \u2014 setup and breakdown handled. Two playlist consultations are included so every moment sounds intentional."
  },
  {
    "question": "Do you travel outside South Florida?",
    "answer": "Yes \u2014 destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end \u2014 you just get the date and the dance floor."
  },
  {
    "question": "Do you provide lighting?",
    "answer": "Dubbz partners with trusted South Florida lighting vendors for uplighting, dance-floor lighting, and full production design \u2014 coordinated as one package so the look and the sound arrive together. Uplighting and dance-floor lighting starts at $400; photo-booth coordination at $150. One point of contact, no vendor juggling."
  },
  {
    "question": "What's your backup plan?",
    "answer": "Redundancy at every level: a backup laptop, controller, and audio interface travel to every gig, music libraries live on USB and in the cloud, and corporate liability insurance is included. In 10+ years and over a thousand events, the show has never stopped for gear."
  },
  {
    "question": "Do you need a deposit?",
    "answer": "Yes \u2014 a 50% non-refundable deposit secures your date, payable by Venmo, Zelle, check, or wire. The balance is due 7 days before the event. Once the deposit lands, the date is locked and planning begins \u2014 playlist consultations, timeline work, and vendor coordination."
  },
  {
    "question": "Can we meet before booking?",
    "answer": "Absolutely \u2014 every booking starts with a free 30-minute consultation, on Zoom or in person, to talk through your vision, logistics, and budget. It's as much about fit as it is about details: you should know exactly who you're trusting with your event before any deposit changes hands."
  }
];
---

<BaseLayout title="DJ Services — You Know Me As Dubbz" description="Professional DJ services for weddings, corporate events, nightclubs, and private parties in South Florida. Custom playlists, MC services, full production." faqItems={faqItems}>
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- PAGE HERO -->
    <section class="section section-hero">
      <div class="container">
        <header class="page-header">
          <span class="page-greeting">WHAT I DO</span>
          <h1 class="page-title">DJ Services</h1>
          <p class="page-description">Professional DJ services tailored for your event. From intimate weddings to high-energy club nights, corporate galas to custom music production.</p>
        </header>
      </div>
    </section>

    <!-- WEDDINGS & PRIVATE EVENTS -->
    <section class="section" id="weddings">
      <div class="container">
        <div class="service-detail grid grid-2">
          <div class="service-visual">
            <div class="service-image-placeholder panel">
              <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="500" height="400" fill="var(--color-primary)"/>
                <path d="M250 100L150 300h200L250 100Z" stroke="var(--color-accent)" stroke-width="4" fill="none"/>
                <circle cx="250" cy="180" r="30" fill="var(--color-accent)"/>
                <rect x="200" y="250" width="100" height="5" rx="2.5" fill="var(--color-accent)"/>
              </svg>
            </div>
          </div>
          <div class="service-content panel">
            <span class="service-category">Weddings & Private Events</span>
            <h2>Tailored Music From Ceremony to Last Dance</h2>
            <p class="service-lead">Your wedding day deserves a soundtrack as unique as your love story. We work with you to curate every moment — from the walk down the aisle to the final song of the night.</p>
            <ul class="service-features">
              <li><strong>Custom Playlist Consultation</strong> — Two included sessions to nail every song choice</li>
              <li><strong>Professional MC Services</strong> — Announcements, introductions, timeline management</li>
              <li><strong>Ceremony → Cocktail → Reception Flow</strong> — Seamless transitions, zero dead air</li>
              <li><strong>Wireless Mic for Speeches</strong> — Crystal clear audio for toasts and vows</li>
              <li><strong>Setup & Breakdown Included</strong> — We handle the gear, you enjoy the party</li>
              <li><strong>Backup Equipment On-Site</strong> — Redundancy for peace of mind</li>
              <li><strong>South Florida Travel Included</strong> — No hidden fees within service area</li>
            </ul>
            <h3 style="font-family:var(--font-display);font-size:22px;margin:28px 0 12px">How much does a wedding DJ cost in South Florida?</h3>
            <p style="color:var(--color-text-muted);font-size:15px;margin-bottom:20px">Professional wedding DJ services start at <strong style="color:var(--ink)">$1,500</strong>. That includes ceremony sound, cocktail hour, full reception DJing, wireless mics for speeches, custom playlist curation, timeline coordination, and all professional audio equipment. Add-ons like uplighting and photo booth coordination are available.</p>
            <div class="service-pricing">
              <span class="price">Starting at <strong>$1,500</strong></span>
              <span class="price-note">50% deposit to hold date · Balance due day-of</span>
            </div>
            <div class="service-addons">
              <h4>Popular Add-ons</h4>
              <ul>
                <li>Live streaming for remote guests — +$200</li>
                <li>Custom remix of first dance song — +$300</li>
                <li>Photo booth coordination — +$150</li>
                <li>Uplighting / dance floor lighting — +$400</li>
              </ul>
            </div>
            <a href="/contact" class="btn btn-primary btn-lg">Inquire About Your Wedding</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CORPORATE EVENTS -->
    <section class="section section-alt" id="corporate">
      <div class="container">
        <div class="service-detail grid grid-2 reverse">
          <div class="service-visual">
            <div class="service-image-placeholder panel">
              <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="500" height="400" fill="var(--color-primary)"/>
                <rect x="50" y="80" width="400" height="200" rx="8" stroke="var(--color-accent)" stroke-width="4" fill="none"/>
                <rect x="70" y="100" width="120" height="30" rx="4" fill="var(--color-accent)"/>
                <rect x="70" y="140" width="200" height="16" rx="2" fill="var(--color-gray-600)"/>
                <rect x="70" y="165" width="180" height="16" rx="2" fill="var(--color-gray-600)"/>
                <circle cx="400" cy="300" r="60" stroke="var(--color-accent)" stroke-width="3" fill="none"/>
                <path d="M370 300l15 15 25-25" stroke="var(--color-accent)" stroke-width="3" fill="none"/>
              </svg>
            </div>
          </div>
          <div class="service-content panel">
            <span class="service-category">Corporate Events</span>
            <h2>Brand-Aligned Music Programming</h2>
            <p class="service-lead">From product launches to holiday galas, conferences to team builders — we deliver professional, on-brand music experiences that elevate your event without overshadowing your message.</p>
            <ul class="service-features">
              <li><strong>Pre-Event Brand Consultation</strong> — We learn your culture, values, and vibe</li>
              <li><strong>Custom Walk-In / Walk-Out Music</strong> — Branded intros, transitions, stings</li>
              <li><strong>Presentation Audio Support</strong> — Wireless mics, mixer integration, recording</li>
              <li><strong>Dress Code Compliant</strong> — Black tie, business casual, themed attire</li>
              <li><strong>Corporate Liability Insurance</strong> — COI provided, venue requirements met</li>
              <li><strong>Invoice / Net-30 Terms</strong> — Procurement-friendly billing</li>
            </ul>
            <h3 style="font-family:var(--font-display);font-size:22px;margin:28px 0 12px">What does a corporate event DJ cost?</h3>
            <p style="color:var(--color-text-muted);font-size:15px;margin-bottom:20px">Corporate event DJ services start at <strong style="color:var(--ink)">$2,000</strong>. That includes pre-event brand consultation, custom walk-in and walk-out music, presentation audio support, wireless mics, corporate liability insurance, and Net-30 invoicing for procurement.</p>
            <div class="service-pricing">
              <span class="price">Starting at <strong>$2,000</strong></span>
              <span class="price-note">Custom quotes based on scope, duration, location</span>
            </div>
            <div class="service-addons">
              <h4>Popular Add-ons</h4>
              <ul>
                <li>Live streaming / hybrid event support — +$500</li>
                <li>Custom branded transition audio — +$300</li>
                <li>Multi-room audio zones — +$400/zone</li>
                <li>Post-event highlight reel with licensed music — +$600</li>
              </ul>
            </div>
            <a href="/contact" class="btn btn-primary btn-lg">Request Corporate Quote</a>
          </div>
        </div>
      </div>
    </section>

    <!-- NIGHTLIFE & CLUBS -->
    <section class="section" id="nightlife">
      <div class="container">
        <div class="service-detail grid grid-2">
          <div class="service-visual">
            <div class="service-image-placeholder panel">
              <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="500" height="400" fill="var(--color-primary)"/>
                <circle cx="250" cy="180" r="80" stroke="var(--color-accent)" stroke-width="4" fill="none"/>
                <path d="M250 100L200 260M250 100L300 260" stroke="var(--color-accent)" stroke-width="3"/>
                <circle cx="250" cy="180" r="30" fill="var(--color-accent)"/>
                <rect x="220" y="280" width="60" height="40" rx="4" fill="var(--color-accent)"/>
                <circle cx="180" cy="180" r="15" fill="var(--color-gray-600)"/>
                <circle cx="320" cy="180" r="15" fill="var(--color-gray-600)"/>
              </svg>
            </div>
          </div>
          <div class="service-content panel">
            <span class="service-category">Nightlife & Clubs</span>
            <h2>High-Energy Sets That Pack the Dance Floor</h2>
            <p class="service-lead">Genre-fluid, crowd-reading, energy-management — we keep the floor moving and the bar ringing. Open format, house, hip-hop, afrobeats, dancehall, latin, top 40.</p>
            <ul class="service-features">
              <li><strong>Genre-Flexible</strong> — House, Hip-Hop, Afrobeats, Dancehall, Top 40, Latin, Open Format</li>
              <li><strong>Crowd Reading & Energy Management</strong> — Build, peak, sustain, bring down</li>
              <li><strong>Professional Rider Provided</strong> — Technical specs, hospitality, logistics</li>
              <li><strong>Promo Support</strong> — Social posts, stories, flyer assets, ticket push</li>
              <li><strong>Recording / Live Stream Available</strong> — Content for your channels</li>
            </ul>
            <div class="service-pricing">
              <span class="price"><strong>Residency & Guest Spot Rates</strong></span>
              <span class="price-note">Custom per venue, date, duration, market</span>
            </div>
            <div class="current-residencies">
              <h4>Current Residencies</h4>
              <ul>
                <li><strong>Avacado Cantina</strong> — Saturdays, 8-11 PM (Palm Beach Gardens)</li>
                <li><strong>FLAVAR Call Collect</strong> — Monthly Sundays, 3 PM-Close (Northwood Village, WPB)</li>
              </ul>
            </div>
            <a href="/contact" class="btn btn-primary btn-lg">Book a Guest Spot</a>
          </div>
        </div>
      </div>
    </section>

    <!-- MUSIC PRODUCTION (DWBEATBEAST) -->
    <section class="section section-alt" id="production">
      <div class="container">
        <div class="service-detail grid grid-2 reverse">
          <div class="service-visual">
            <div class="service-image-placeholder panel">
              <svg viewBox="0 0 500 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="500" height="400" fill="var(--color-primary)"/>
                <path d="M50 300 Q250 50 450 300" stroke="var(--color-accent)" stroke-width="4" fill="none"/>
                <circle cx="150" cy="200" r="10" fill="var(--color-accent)"/>
                <circle cx="250" cy="120" r="10" fill="var(--color-accent)"/>
                <circle cx="350" cy="200" r="10" fill="var(--color-accent)"/>
                <rect x="230" y="280" width="40" height="80" rx="4" fill="var(--color-accent)"/>
                <rect x="220" y="360" width="60" height="20" rx="2" fill="var(--color-gray-600)"/>
              </svg>
            </div>
          </div>
          <div class="service-content panel">
            <span class="service-category">Music Production (as DWBEATBEAST)</span>
            <h2>Custom Productions, Remixes & Beats</h2>
            <p class="service-lead">Original productions, official remixes, custom beats for artists and content creators. Sync-licensing ready, stems delivered, revisions included.</p>
            <div class="production-services grid grid-3">
              <article class="production-item panel">
                <h4>Custom Beat Production</h4>
                <p class="price">$300–800 / track</p>
                <ul>
                  <li>Exclusive rights</li>
                  <li>Stems + WAV + MP3</li>
                  <li>2 revisions included</li>
                  <li>Sync licensing ready</li>
                </ul>
              </article>
              <article class="production-item panel">
                <h4>Official Remix</h4>
                <p class="price">$500–1,500</p>
                <ul>
                  <li>Stem separation from original</li>
                  <li>Genre of your choice</li>
                  <li>Radio + extended edits</li>
                  <li>Cleared for release</li>
                </ul>
              </article>
              <article class="production-item panel">
                <h4>Mixing & Mastering</h4>
                <p class="price">$150–300 / song</p>
                <ul>
                  <li>Analog-modeled processing</li>
                  <li>Streaming platform optimized</li>
                  <li>Revision rounds included</li>
                  <li>DDP / WAV / MP3 delivery</li>
                </ul>
              </article>
            </div>
            <a href="/contact" class="btn btn-primary btn-lg">Discuss Your Project</a>
          </div>
        </div>
      </div>
    </section>

    <!-- BOOKING PROCESS -->
    <section class="section" id="booking-process">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Booking Process</h2>
        </header>
        <div class="process-steps grid grid-4">
          <article class="process-step panel">
            <div class="step-number">1</div>
            <h3>Inquire</h3>
            <p>Fill out the contact form with date, venue, event type, and vision.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">2</div>
            <h3>Consult</h3>
            <p>15-min call to discuss logistics, budget, and musical direction.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">3</div>
            <h3>Proposal</h3>
            <p>Detailed quote with rider, timeline, payment schedule, and contract.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">4</div>
            <h3>Deposit</h3>
            <p>50% holds your date (Venmo, Zelle, Check, Wire). Date locked.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">5</div>
            <h3>Plan</h3>
            <p>Playlist collaboration, timeline finalization, vendor coordination.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">6</div>
            <h3>Perform</h3>
            <p>Show up early, deliver flawlessly, exceed expectations.</p>
          </article>
          <article class="process-step panel">
            <div class="step-number">7</div>
            <h3>Balance</h3>
            <p>Remaining balance due day-of or per corporate terms.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="travel-question" style="background:var(--bg2);border-top:1px solid var(--gold-faint);border-bottom:1px solid var(--gold-faint)">
      <div class="container">
        <header class="section-header center">
          <h2 class="section-title">Do DJs travel for destination weddings?</h2>
          <p class="section-summary">Yes — destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package. Outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end — you just get the date and the dance floor. <a href="#faq" style="color:var(--color-accent)">See the FAQ for details.</a></p>
        </header>
      </div>
    </section>

    <!-- SERVICE AREA -->
    <section class="section section-alt" id="service-area">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Service Area</h2>
        </header>
        <div class="area-grid grid grid-3">
          <div class="area-card panel">
            <h3>Primary (No Travel Fee)</h3>
            <ul>
              <li>West Palm Beach</li>
              <li>Palm Beach Gardens</li>
              <li>Jupiter</li>
              <li>Boca Raton</li>
              <li>Fort Lauderdale</li>
              <li>Miami / Miami Beach</li>
              <li>Key Biscayne</li>
            </ul>
          </div>
          <div class="area-card panel">
            <h3>Extended (Travel Fee Applies)</h3>
            <ul>
              <li>Florida Keys</li>
              <li>Naples</li>
              <li>Orlando</li>
              <li>Tampa</li>
              <li>All of South FL</li>
            </ul>
          </div>
          <div class="area-card panel">
            <h3>Destination</h3>
            <ul>
              <li>Domestic US</li>
              <li>Caribbean</li>
              <li>International</li>
              <li>Custom quote</li>
              <li>All logistics handled</li>
            </ul>
          </div>
        </div>
      </div>
    </section>


    <!-- TESTIMONIALS -->
    <section class="section" id="testimonials" style="background:var(--bg2);border-top:1px solid var(--gold-faint)">
      <div class="container">
        <header class="section-header center">
          <span class="section-kicker">What clients say</span>
          <h2 class="section-title">Trusted by South Florida's best events</h2>
        </header>
        <div class="testimonials-grid grid grid-2" style="margin-top:48px">
          <article class="testimonial-card panel" style="padding:32px 28px">
            <div style="color:var(--gold);font-size:16px;margin-bottom:12px">★★★★★</div>
            <blockquote style="margin:0 0 16px"><p style="font-size:14px;line-height:1.7;font-style:italic;color:var(--ink);margin:0">"Dubbz read the room perfectly — our guests are still talking about the music three months later."</p></blockquote>
            <footer style="font-size:12px;color:var(--muted)"><strong style="color:var(--ink)">Sarah & Marcus</strong><span style="margin-left:6px">Engagement Party, The Moore Miami</span></footer>
          </article>
          <article class="testimonial-card panel" style="padding:32px 28px">
            <div style="color:var(--gold);font-size:16px;margin-bottom:12px">★★★★★</div>
            <blockquote style="margin:0 0 16px"><p style="font-size:14px;line-height:1.7;font-style:italic;color:var(--ink);margin:0">"We've booked Dubbz for multiple Friday nights now, and the energy is consistently on point. Professional, reliable, and the music is always fresh."</p></blockquote>
            <footer style="font-size:12px;color:var(--muted)"><strong style="color:var(--ink)">Jeanie Joseph</strong><span style="margin-left:6px">Thank You Fridays, Red Rooster</span></footer>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="booking-question" style="background:var(--bg2);border-top:1px solid var(--gold-faint);border-bottom:1px solid var(--gold-faint)">
      <div class="container">
        <header class="section-header center">
          <h2 class="section-title">How far in advance should I book a wedding DJ?</h2>
          <p class="section-summary">For weddings, 9–12 months out is the sweet spot — prime Saturdays book first. Corporate events and club dates usually lock in 2–6 months ahead. Last-minute inquiries are always welcome; if the date's open, it's yours. The 50% deposit is what holds your date, not the inquiry. <a href="#faq" style="color:var(--color-accent)">Read all FAQs below.</a></p>
        </header>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Frequently Asked Questions</h2>
        </header>
        <div class="faq-grid">
          <details class="faq-item">
            <summary>How far in advance should I book?</summary>
            <p>For weddings, 9–12 months out is the sweet spot — prime Saturdays book first. Corporate events and club dates usually lock in 2–6 months ahead. Running late? Last-minute inquiries are always welcome; if the date’s open, it’s yours. Either way, the 50% deposit is what holds your date, not the inquiry.</p>
          </details>
          <details class="faq-item">
            <summary>Do you take song requests?</summary>
            <p>Absolutely — your must-play and do-not-play lists are the starting point, and guests can make requests on the night. The skill is honoring your taste while reading the room: if a request would clear the floor, it waits for the right moment. You set the boundaries; Dubbz handles the timing.</p>
          </details>
          <details class="faq-item">
            <summary>What's included in a wedding package?</summary>
            <p>Every wedding package starts at $1,500 and includes ceremony sound, cocktail hour, full reception DJing, wireless mics for speeches and toasts, custom playlist curation, timeline coordination with your planner, and all professional audio equipment — setup and breakdown handled. Two playlist consultations are included so every moment sounds intentional.</p>
          </details>
          <details class="faq-item">
            <summary>Do you travel outside South Florida?</summary>
            <p>Yes — destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end — you just get the date and the dance floor.</p>
          </details>
          <details class="faq-item">
            <summary>Do you provide lighting?</summary>
            <p>Dubbz partners with trusted South Florida lighting vendors for uplighting, dance-floor lighting, and full production design — coordinated as one package so the look and the sound arrive together. Uplighting and dance-floor lighting starts at $400; photo-booth coordination at $150. One point of contact, no vendor juggling.</p>
          </details>
          <details class="faq-item">
            <summary>What's your backup plan?</summary>
            <p>Redundancy at every level: a backup laptop, controller, and audio interface travel to every gig, music libraries live on USB and in the cloud, and corporate liability insurance is included. In 10+ years and over a thousand events, the show has never stopped for gear.</p>
          </details>
          <details class="faq-item">
            <summary>Do you need a deposit?</summary>
            <p>Yes — a 50% non-refundable deposit secures your date, payable by Venmo, Zelle, check, or wire. The balance is due 7 days before the event. Once the deposit lands, the date is locked and planning begins — playlist consultations, timeline work, and vendor coordination.</p>
          </details>
          <details class="faq-item">
            <summary>Can we meet before booking?</summary>
            <p>Absolutely — every booking starts with a free 30-minute consultation, on Zoom or in person, to talk through your vision, logistics, and budget. It’s as much about fit as it is about details: you should know exactly who you’re trusting with your event before any deposit changes hands.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section services-cta">
      <div class="container">
        <div class="cta-panel panel">
          <h2 class="cta-title">Ready to Book?</h2>
          <p class="cta-text">Limited dates available for peak season. Let's talk about your event vision and lock in your date.</p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Start Your Inquiry</a>
            <a href="tel:+13059022698" class="btn btn-gold btn-lg">Call Now: (305) 902-2698</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    #main-content {
      overflow: clip;
    }

    .section-hero {
      padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 96px);
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 82% 18%, rgba(0, 212, 255, 0.12), transparent 34%);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .page-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .page-greeting {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: var(--space-4);
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }

    .service-detail {
      gap: clamp(32px, 6vw, 72px);
      align-items: center;
      margin-bottom: clamp(64px, 8vw, 112px);
    }

    .service-detail.reverse {
      direction: rtl;
    }

    .service-detail.reverse > * {
      direction: ltr;
    }

    .services-cta {
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 50% 0%, rgba(255, 215, 0, 0.10), transparent 40%);
    }

    @media (max-width: 1024px) {
      .service-detail,
      .service-detail.reverse {
        grid-template-columns: 1fr;
        direction: ltr;
      }
    }

    .service-visual {
      display: flex;
      justify-content: center;
    }

    .service-image-placeholder {
      width: 100%;
      aspect-ratio: 5/4;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
    }

    .service-image-placeholder svg {
      width: 100%;
      height: 100%;
    }

    .service-content {
      padding: var(--space-8);
    }

    .service-category {
      display: inline-block;
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-accent);
      font-family: var(--font-display);
      margin-bottom: var(--space-3);
    }

    .service-content h2 {
      margin-bottom: var(--space-4);
    }

    .service-lead {
      font-size: var(--text-lg);
      color: var(--color-text);
      margin-bottom: var(--space-6);
      font-weight: 500;
    }

    .service-features {
      list-style: none;
      margin-bottom: var(--space-6);
    }

    .service-features li {
      margin-bottom: var(--space-3);
      padding-left: var(--space-6);
      position: relative;
      font-size: var(--text-base);
      color: var(--color-text-muted);
    }

    .service-features li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--color-accent);
      font-weight: bold;
      font-size: var(--text-lg);
    }

    .service-pricing {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      margin-bottom: var(--space-6);
    }

    .price {
      font-size: var(--text-2xl);
      font-family: var(--font-display);
      color: var(--color-white);
    }

    .price-note {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .service-addons h4 {
      margin-bottom: var(--space-3);
      font-size: var(--text-base);
    }

    .service-addons ul {
      list-style: none;
    }

    .service-addons li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      padding-left: var(--space-6);
      position: relative;
    }

    .service-addons li::before {
      content: '+';
      position: absolute;
      left: 0;
      color: var(--color-gold);
      font-weight: bold;
    }

    .current-residencies h4 {
      margin-bottom: var(--space-3);
      font-size: var(--text-base);
    }

    .current-residencies ul {
      list-style: none;
    }

    .current-residencies li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .production-services {
      gap: var(--space-6);
      margin-bottom: var(--space-8);
    }

    .production-item {
      padding: var(--space-6);
      text-align: center;
    }

    .production-item h4 {
      margin-bottom: var(--space-2);
    }

    .production-item .price {
      font-size: var(--text-xl);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
      display: block;
    }

    .production-item ul {
      list-style: none;
      text-align: left;
    }

    .production-item li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      padding-left: var(--space-6);
      position: relative;
    }

    .production-item li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .process-steps {
      gap: var(--space-4);
    }

    .process-step {
      text-align: center;
      padding: var(--space-6);
      position: relative;
    }

    .process-step::after {
      content: '';
      position: absolute;
      top: 30px;
      right: -50%;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--color-accent), transparent);
      z-index: -1;
    }

    .process-step:last-child::after {
      display: none;
    }

    @media (max-width: 768px) {
      .process-step::after {
        display: none;
      }
    }

    .step-number {
      width: 60px;
      height: 60px;
      border: var(--outline-weight) solid var(--color-accent);
      background: var(--color-primary);
      color: var(--color-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto var(--space-4);
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      transition: all var(--transition-base);
    }

    .process-step:hover .step-number {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: scale(1.1) rotate(-3deg);
    }

    .process-step h3 {
      font-size: var(--text-lg);
      margin-bottom: var(--space-2);
    }

    .process-step p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .area-grid {
      gap: var(--space-6);
    }

    .area-card {
      padding: var(--space-6);
    }

    .area-card h3 {
      font-size: var(--text-lg);
      margin-bottom: var(--space-4);
      color: var(--color-accent);
    }

    .area-card ul {
      list-style: none;
    }

    .area-card li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      padding-left: var(--space-6);
      position: relative;
    }

    .area-card li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .btn-lg {
      padding: var(--space-4) var(--space-8);
      font-size: var(--text-lg);
    }

    @media (max-width: 640px) {
      .production-services {
        grid-template-columns: 1fr;
      }

      .process-steps {
        grid-template-columns: repeat(2, 1fr);
      }

      .area-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 480px) {
      .process-steps {
        grid-template-columns: 1fr;
      }
    }

    /* FAQ Styles */
    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-4);
      max-width: 900px;
      margin: 0 auto;
    }

    .faq-item {
      background: var(--color-surface);
      border: var(--outline-weight) solid var(--color-border);
      border-radius: 0;
      overflow: hidden;
    }

    .faq-item summary {
      padding: var(--space-5);
      cursor: pointer;
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 400;
      color: var(--color-white);
      list-style: none;
      position: relative;
      padding-right: var(--space-10);
      transition: color var(--transition-fast);
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary::after {
      content: '+';
      position: absolute;
      right: var(--space-5);
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-mono);
      font-size: var(--text-xl);
      color: var(--color-accent);
      transition: transform var(--transition-fast);
    }

    .faq-item[open] summary::after {
      transform: translateY(-50%) rotate(45deg);
    }

    .faq-item[open] summary {
      color: var(--color-accent);
    }

    .faq-item p {
      padding: 0 var(--space-5) var(--space-5);
      margin: 0;
      color: var(--color-text-muted);
      line-height: 1.7;
    }

    @media (max-width: 640px) {
      .faq-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>