---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DubbzIllustration from '../components/DubbzIllustration.astro';
---

<BaseLayout title="About — You Know Me As Dubbz" description="Learn about You Know Me As Dubbz — South Florida's premier DJ and event production company. Over 10 years of professional experience delivering unforgettable music experiences.">
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- ABOUT HERO -->
    <section class="section section-hero">
      <div class="container">
        <div class="about-hero-grid">
          <div class="about-hero-content animate-slide-in-left">
            <span class="page-greeting">THE STORY</span>
            <h1 class="page-title">About Dubbz</h1>
            <p class="page-description">South Florida-based entertainment company providing professional DJ services and event production. Over 10 years of professional experience delivering tailored, high-energy music experiences.</p>
          </div>
          <div class="about-hero-illustration animate-slide-in-right">
            <DubbzIllustration class="about-dubbz" />
          </div>
        </div>
      </div>
    </section>

    <!-- BIO -->
    <section class="section">
      <div class="container">
        <div class="bio-grid grid grid-2">
          <div class="bio-content panel">
            <h2 class="bio-title">The Journey</h2>
            <div class="dotted-divider"></div>
            <p class="bio-lead">Born and raised in South Florida, the path to DJing started early — crate-digging, bedroom mixing, and studying the greats. What began as a passion for curating the perfect soundtrack evolved into a full-time career spanning weddings, corporate galas, nightclubs, and destination events.</p>
            <p>Over a decade later, the mission remains the same: <strong>read the room, match the energy, exceed expectations.</strong> Whether it's an intimate ceremony for 50 or a festival stage for 5,000, the approach is personal, professional, and always prepared.</p>
            <p>The signature sound is <em>open-format with intention</em> — blending house, hip-hop, afrobeats, dancehall, top 40, latin, and classics into a cohesive journey. No two sets are identical because no two rooms are identical.</p>
            <a href="/contact" class="btn btn-primary btn-lg" style="margin-top: var(--space-6);">Start a Conversation</a>
          </div>
          <div class="bio-highlights">
            <article class="highlight-card panel">
              <span class="number-badge">10+</span>
              <h3>Years Professional</h3>
              <p>Full-time DJ since 2014. Hundreds of events across every format imaginable.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">1000+</span>
              <h3>Events Performed</h3>
              <p>Weddings, corporate, clubs, festivals, private parties — every crowd, every size.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">50+</span>
              <h3>Weddings</h3>
              <p>From courthouse ceremonies to 300-guest ballroom receptions. Ceremony-to-last-dance expertise.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">2</span>
              <h3>Brand Identities</h3>
              <p><strong>You Know Me As Dubbz</strong> — DJ & events<br><strong>DWBEATBEAST</strong> — Music production</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- PHILOSOPHY / APPROACH -->
    <section class="section section-alt">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">The Approach</h2>
        </header>
        <div class="approach-grid grid grid-3">
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <h3>Preparation First</h3>
            <p>Detailed consultations, custom playlists, do-not-play lists, timeline coordination, vendor communication. Zero surprises on event day.</p>
          </article>
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>Professional Grade</h3>
            <p>Industry-standard equipment (CDJs, controllers, backup systems), liability insurance, contracts, riders, and punctuality — every time.</p>
          </article>
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20"/>
              </svg>
            </div>
            <h3>Energy Management</h3>
            <p>Build, peak, sustain, bring down. Reading the room in real-time and adjusting. The art isn't song selection — it's moment creation.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ROSTER / PRESS / AWARDS EQUIVALENT -->
    <section class="section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Notable Events & Clients</h2>
        </header>
        <div class="roster-grid">
          <div class="roster-column">
            <h3>Venues & Events</h3>
            <ul class="roster-list">
              <li>Avacado Cantina — Weekly Residency</li>
              <li>FLAVAR Call Collect — Monthly Series</li>
              <li>Camelot Yacht Club — All White Party</li>
              <li>Palm House Hotel — The Bar</li>
              <li>French Grille — Northwood Village</li>
              <li>Benjamin School — Private Events</li>
            </ul>
          </div>
          <div class="roster-column">
            <h3>Event Types Delivered</h3>
            <ul class="roster-list">
              <li>Weddings (50-300 guests)</li>
              <li>Corporate Galas & Conferences</li>
              <li>Product Launches & Activations</li>
              <li>Holiday Parties</li>
              <li>Nightclub Residencies</li>
              <li>Festival Stages</li>
              <li>Destination Events</li>
            </ul>
          </div>
          <div class="roster-column">
            <h3>Genres & Formats</h3>
            <ul class="roster-list">
              <li>House / Deep House / Tech House</li>
              <li>Hip-Hop / R&B</li>
              <li>Afrobeats / Amapiano</li>
              <li>Dancehall / Reggae / Kompa</li>
              <li>Latin / Reggaeton / Bachata</li>
              <li>Top 40 / Open Format</li>
              <li>Classics / Throwbacks</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DWBEATBEAST NOTE -->
    <section class="section section-alt">
      <div class="container">
        <div class="dwbeatbeast-panel panel">
          <div class="dwbeatbeast-content">
            <span class="dwbeatbeast-label">SEPARATE IDENTITY</span>
            <h2>DWBEATBEAST — Music Production</h2>
            <p>Original productions, official remixes, custom beats for artists, sync licensing, mixing & mastering. A distinct creative lane from the DJ brand — same ears, different output.</p>
            <a href="/services#production" class="btn btn-gold">Explore Production Services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section about-cta">
      <div class="container">
        <div class="cta-panel panel">
          <h2 class="cta-title">Let's Create Something Memorable</h2>
          <p class="cta-text">Your event deserves a soundtrack that matches the moment. Reach out and let's talk about your vision.</p>
          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-lg">Start Your Inquiry</a>
            <a href="/mixes" class="btn btn-secondary btn-lg">Hear the Sound</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    #main-content {
      overflow: clip;
    }

    .section-hero {
      padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 96px);
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 82% 18%, rgba(0, 212, 255, 0.12), transparent 34%);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .about-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
      align-items: center;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    .about-hero-content {
      text-align: left;
    }

    .page-greeting {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: var(--space-4);
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      max-width: 100%;
    }

    .about-dubbz {
      width: 100%;
      max-width: 450px;
      margin: 0 auto;
      filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.3));
    }

    @media (max-width: 1024px) {
      .about-hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .about-hero-content {
        order: 2;
      }

      .about-hero-illustration {
        order: 1;
      }

      .about-dubbz {
        max-width: 350px;
      }
    }

    @media (max-width: 640px) {
      .about-dubbz {
        max-width: 300px;
      }
    }

    /* BIO */
    .bio-grid {
      gap: var(--space-8);
      align-items: start;
    }

    .bio-content {
      padding: var(--space-8);
    }

    .bio-title {
      margin-bottom: var(--space-4);
    }

    .bio-lead {
      font-size: var(--text-lg);
      color: var(--color-text);
      margin-bottom: var(--space-4);
      font-weight: 500;
    }

    .bio-content p {
      margin-bottom: var(--space-4);
    }

    .bio-highlights {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .highlight-card {
      padding: var(--space-6);
      text-align: center;
    }

    .highlight-card .number-badge {
      display: block;
      margin-bottom: var(--space-3);
      opacity: 0.2;
    }

    .highlight-card h3 {
      font-size: var(--text-base);
      margin-bottom: var(--space-2);
    }

    .highlight-card p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin: 0;
    }

    @media (max-width: 768px) {
      .bio-grid {
        grid-template-columns: 1fr;
      }

      .bio-highlights {
        grid-template-columns: 1fr;
      }
    }

    /* APPROACH */
    .approach-grid {
      gap: clamp(24px, 4vw, 48px);
    }

    .about-cta {
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 50% 0%, rgba(255, 215, 0, 0.10), transparent 40%);
    }

    .approach-card {
      padding: var(--space-8);
      text-align: center;
    }

    .approach-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border: var(--outline-weight) solid var(--color-accent);
      background: var(--color-primary);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
    }

    .approach-card:hover .approach-icon {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: rotate(-3deg) scale(1.05);
      transition: all var(--transition-base);
    }

    .approach-card h3 {
      font-size: var(--text-lg);
      margin-bottom: var(--space-2);
    }

    .approach-card p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin: 0;
    }

    /* ROSTER */
    .roster-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .roster-column h3 {
      font-size: var(--text-lg);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--color-accent);
      display: inline-block;
    }

    .roster-list {
      list-style: none;
    }

    .roster-list li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      padding-left: var(--space-6);
      position: relative;
    }

    .roster-list li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    @media (max-width: 768px) {
      .roster-grid {
        grid-template-columns: 1fr;
      }
    }

    /* DWBEATBEAST */
    .dwbeatbeast-panel {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
      padding: var(--space-12);
    }

    .dwbeatbeast-label {
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-gold);
      display: block;
      margin-bottom: var(--space-4);
    }

    .dwbeatbeast-content h2 {
      margin-bottom: var(--space-4);
    }

    .dwbeatbeast-content p {
      color: var(--color-text-muted);
      margin-bottom: var(--space-6);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    /* CTA */
    .cta-section {
      background: var(--color-surface);
    }

    .cta-panel {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      padding: var(--space-16);
    }

    .cta-title {
      margin-bottom: var(--space-4);
    }

    .cta-text {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      margin-bottom: var(--space-8);
      max-width: 100%;
    }

    .cta-actions {
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    @media (max-width: 640px) {
      .cta-panel {
        padding: var(--space-10);
      }
    }
  </style>
</BaseLayout>