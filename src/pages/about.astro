---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqItems = [
  {
    "question": "How far in advance should I book?",
    "answer": "For weddings, 9\u201312 months out is the sweet spot \u2014 prime Saturdays book first. Corporate events and club dates usually lock in 2\u20136 months ahead. Running late? Last-minute inquiries are always welcome; if the date's open, it's yours. Either way, the 50% deposit is what holds your date, not the inquiry."
  },
  {
    "question": "Do you take song requests?",
    "answer": "Absolutely \u2014 your must-play and do-not-play lists are the starting point, and guests can make requests on the night. The skill is honoring your taste while reading the room: if a request would clear the floor, it waits for the right moment. You set the boundaries; Dubbz handles the timing."
  },
  {
    "question": "What's included in a wedding package?",
    "answer": "Every wedding package starts at $1,500 and includes ceremony sound, cocktail hour, full reception DJing, wireless mics for speeches and toasts, custom playlist curation, timeline coordination with your planner, and all professional audio equipment \u2014 setup and breakdown handled. Two playlist consultations are included so every moment sounds intentional."
  },
  {
    "question": "Do you travel outside South Florida?",
    "answer": "Yes \u2014 destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end \u2014 you just get the date and the dance floor."
  },
  {
    "question": "Do you provide lighting?",
    "answer": "Dubbz partners with trusted South Florida lighting vendors for uplighting, dance-floor lighting, and full production design \u2014 coordinated as one package so the look and the sound arrive together. Uplighting and dance-floor lighting starts at $400; photo-booth coordination at $150. One point of contact, no vendor juggling."
  },
  {
    "question": "What's your backup plan?",
    "answer": "Redundancy at every level: a backup laptop, controller, and audio interface travel to every gig, music libraries live on USB and in the cloud, and corporate liability insurance is included. In 10+ years and over a thousand events, the show has never stopped for gear."
  },
  {
    "question": "Do you need a deposit?",
    "answer": "Yes \u2014 a 50% non-refundable deposit secures your date, payable by Venmo, Zelle, check, or wire. The balance is due 7 days before the event. Once the deposit lands, the date is locked and planning begins \u2014 playlist consultations, timeline work, and vendor coordination."
  },
  {
    "question": "Can we meet before booking?",
    "answer": "Absolutely \u2014 every booking starts with a free 30-minute consultation, on Zoom or in person, to talk through your vision, logistics, and budget. It's as much about fit as it is about details: you should know exactly who you're trusting with your event before any deposit changes hands."
  }
];
---

<BaseLayout title="About — You Know Me As Dubbz" description="Learn about You Know Me As Dubbz — South Florida's premier DJ and event production company. Over 10 years of professional experience delivering unforgettable music experiences." faqItems={faqItems}>
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- ABOUT HERO -->
    <section class="section section-hero">
      <div class="container">
        <div class="about-hero-grid">
          <div class="about-hero-content animate-slide-in-left">
            <span class="page-greeting">THE STORY</span>
            <h1 class="page-title">About Dubbz</h1>
            <p class="page-description">South Florida-based entertainment company providing professional DJ services and event production. Over 10 years of professional experience delivering tailored, high-energy music experiences.</p>
            <div class="hero-actions" style="margin-top: var(--space-8); display: flex; gap: var(--space-4); flex-wrap: wrap;">
              <a href="/contact/" class="btn btn-primary btn-lg">Start a Conversation</a>
              <a href="/mixes/" class="btn btn-secondary btn-lg">Hear the Sound</a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- COLOR CHANGING BAR -->
    <div class="hero-color-bar" aria-hidden="true"></div>

    <!-- BIO -->
    <section class="section">
      <div class="container">
        <div class="bio-grid grid grid-2">
          <div class="bio-content panel">
            <h2 class="bio-title">The Journey</h2>
            <div class="dotted-divider"></div>
            <p class="bio-lead">Born and raised in South Florida, the path to DJing started early — crate-digging, bedroom mixing, and studying the greats. What began as a passion for curating the perfect soundtrack evolved into a full-time career spanning weddings, corporate galas, nightclubs, and destination events.</p>
            <p>Over a decade later, the mission remains the same: <strong>read the room, match the energy, exceed expectations.</strong> Whether it's an intimate ceremony for 50 or a festival stage for 5,000, the approach is personal, professional, and always prepared.</p>
            <p>The signature sound is <em>open-format with intention</em> — blending house, hip-hop, afrobeats, dancehall, top 40, latin, and classics into a cohesive journey. No two sets are identical because no two rooms are identical.</p>
            <a href="/contact/" class="btn btn-primary btn-lg" style="margin-top: var(--space-6);">Start a Conversation</a>
          </div>
          <div class="bio-highlights">
            <article class="highlight-card panel">
              <span class="number-badge">10+</span>
              <h3>Years Professional</h3>
              <p>Full-time DJ since 2014. Hundreds of events across every format imaginable.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">500+</span>
              <h3>Events Performed</h3>
              <p>Weddings, corporate, clubs, festivals, private parties — every crowd, every size.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">50+</span>
              <h3>Weddings</h3>
              <p>From courthouse ceremonies to 300-guest ballroom receptions. Ceremony-to-last-dance expertise.</p>
            </article>
            <article class="highlight-card panel">
              <span class="number-badge">2</span>
              <h3>Brand Identities</h3>
              <p><strong>You Know Me As Dubbz</strong> — DJ & events<br><strong>DWBEATBEAST</strong> — Music production</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- PHILOSOPHY / APPROACH -->
    <section class="section section-alt">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">The Approach</h2>
        </header>
        <div class="approach-grid grid grid-3">
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            </div>
            <h3>Preparation First</h3>
            <p>Detailed consultations, custom playlists, do-not-play lists, timeline coordination, vendor communication. Zero surprises on event day.</p>
          </article>
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <h3>Professional Grade</h3>
            <p>Industry-standard equipment (CDJs, controllers, backup systems), liability insurance, contracts, riders, and punctuality — every time.</p>
          </article>
          <article class="approach-card panel">
            <div class="approach-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20"/>
              </svg>
            </div>
            <h3>Energy Management</h3>
            <p>Build, peak, sustain, bring down. Reading the room in real-time and adjusting. The art isn't song selection — it's moment creation.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ROSTER / PRESS / AWARDS EQUIVALENT -->
    <section class="section">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Notable Events & Clients</h2>
        </header>
        <div class="roster-grid">
          <div class="roster-column">
            <h3>Venues & Events</h3>
            <ul class="roster-list">
              <li>Avacado Cantina — Weekly Residency</li>
              <li>FLAVAR Call Collect — Monthly Series</li>
              <li>Camelot Yacht Club — All White Party</li>
              <li>Palm House Hotel — The Bar</li>
              <li>French Grille — Northwood Village</li>
              <li>Benjamin School — Private Events</li>
            </ul>
          </div>
          <div class="roster-column">
            <h3>Event Types Delivered</h3>
            <ul class="roster-list">
              <li>Weddings (50-300 guests)</li>
              <li>Corporate Galas & Conferences</li>
              <li>Product Launches & Activations</li>
              <li>Holiday Parties</li>
              <li>Nightclub Residencies</li>
              <li>Festival Stages</li>
              <li>Destination Events</li>
            </ul>
          </div>
          <div class="roster-column">
            <h3>Genres & Formats</h3>
            <ul class="roster-list">
              <li>House / Deep House / Tech House</li>
              <li>Hip-Hop / R&B</li>
              <li>Afrobeats / Amapiano</li>
              <li>Dancehall / Reggae / Kompa</li>
              <li>Latin / Reggaeton / Bachata</li>
              <li>Top 40 / Open Format</li>
              <li>Classics / Throwbacks</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- DWBEATBEAST NOTE -->
    <section class="section section-alt">
      <div class="container">
        <div class="dwbeatbeast-panel panel">
          <div class="dwbeatbeast-content">
            <span class="dwbeatbeast-label">SEPARATE IDENTITY</span>
            <h2>DWBEATBEAST — Music Production</h2>
            <p>Original productions, official remixes, custom beats for artists, sync licensing, mixing & mastering. A distinct creative lane from the DJ brand — same ears, different output.</p>
            <a href="/services/#production" class="btn btn-gold">Explore Production Services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="container">
        <header class="section-header">
          <h2 class="section-title">Frequently Asked Questions</h2>
        </header>
        <div class="faq-grid">
          <details class="faq-item">
            <summary>How far in advance should I book?</summary>
            <p>For weddings, 9–12 months out is the sweet spot — prime Saturdays book first. Corporate events and club dates usually lock in 2–6 months ahead. Running late? Last-minute inquiries are always welcome; if the date’s open, it’s yours. Either way, the 50% deposit is what holds your date, not the inquiry.</p>
          </details>
          <details class="faq-item">
            <summary>Do you take song requests?</summary>
            <p>Absolutely — your must-play and do-not-play lists are the starting point, and guests can make requests on the night. The skill is honoring your taste while reading the room: if a request would clear the floor, it waits for the right moment. You set the boundaries; Dubbz handles the timing.</p>
          </details>
          <details class="faq-item">
            <summary>What's included in a wedding package?</summary>
            <p>Every wedding package starts at $1,500 and includes ceremony sound, cocktail hour, full reception DJing, wireless mics for speeches and toasts, custom playlist curation, timeline coordination with your planner, and all professional audio equipment — setup and breakdown handled. Two playlist consultations are included so every moment sounds intentional.</p>
          </details>
          <details class="faq-item">
            <summary>Do you travel outside South Florida?</summary>
            <p>Yes — destination weddings and events nationwide, plus the Caribbean and international dates. South Florida travel is included in every package; outside that, travel, lodging, and per diem get added to your quote as a single line item. Logistics are handled end to end — you just get the date and the dance floor.</p>
          </details>
          <details class="faq-item">
            <summary>Do you provide lighting?</summary>
            <p>Dubbz partners with trusted South Florida lighting vendors for uplighting, dance-floor lighting, and full production design — coordinated as one package so the look and the sound arrive together. Uplighting and dance-floor lighting starts at $400; photo-booth coordination at $150. One point of contact, no vendor juggling.</p>
          </details>
          <details class="faq-item">
            <summary>What's your backup plan?</summary>
            <p>Redundancy at every level: a backup laptop, controller, and audio interface travel to every gig, music libraries live on USB and in the cloud, and corporate liability insurance is included. In 10+ years and over a thousand events, the show has never stopped for gear.</p>
          </details>
          <details class="faq-item">
            <summary>Do you need a deposit?</summary>
            <p>Yes — a 50% non-refundable deposit secures your date, payable by Venmo, Zelle, check, or wire. The balance is due 7 days before the event. Once the deposit lands, the date is locked and planning begins — playlist consultations, timeline work, and vendor coordination.</p>
          </details>
          <details class="faq-item">
            <summary>Can we meet before booking?</summary>
            <p>Absolutely — every booking starts with a free 30-minute consultation, on Zoom or in person, to talk through your vision, logistics, and budget. It’s as much about fit as it is about details: you should know exactly who you’re trusting with your event before any deposit changes hands.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section about-cta">
      <div class="container">
        <div class="cta-panel panel">
          <h2 class="cta-title">Let's Create Something Memorable</h2>
          <p class="cta-text">Your event deserves a soundtrack that matches the moment. Reach out and let's talk about your vision.</p>
          <div class="cta-actions">
            <a href="/contact/" class="btn btn-primary btn-lg">Start Your Inquiry</a>
            <a href="/mixes/" class="btn btn-secondary btn-lg">Hear the Sound</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    #main-content {
      overflow: clip;
    }

    .section-hero {
      padding: clamp(120px, 14vw, 180px) 0 clamp(56px, 7vw, 96px);
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 82% 18%, rgba(0, 212, 255, 0.12), transparent 34%);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .about-hero-grid {
      display: block;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 var(--container-padding);
    }

    .about-hero-content {
      text-align: left;
      max-width: 600px;
      position: relative;
      z-index: 2;
    }

    .page-greeting {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: var(--space-4);
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      max-width: 100%;
    }

    /* Text legibility scrim — gradient overlay on left side */
    .section-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(15, 15, 26, 0.82) 0%,
        rgba(15, 15, 26, 0.45) 50%,
        rgba(15, 15, 26, 0.15) 100%
      );
      z-index: 1;
      pointer-events: none;
    }

    @media (max-width: 1024px) {
      .about-hero-content {
        max-width: 100%;
      }
    }

    /* BIO */
    .bio-grid {
      gap: var(--space-8);
      align-items: start;
    }

    .bio-content {
      padding: var(--space-8);
    }

    .bio-title {
      margin-bottom: var(--space-4);
    }

    .bio-lead {
      font-size: var(--text-lg);
      color: var(--color-text);
      margin-bottom: var(--space-4);
      font-weight: 500;
    }

    .bio-content p {
      margin-bottom: var(--space-4);
    }

    .bio-highlights {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .highlight-card {
      padding: var(--space-6);
      text-align: center;
    }

    .highlight-card .number-badge {
      display: block;
      margin-bottom: var(--space-3);
      opacity: 0.2;
    }

    .highlight-card h3 {
      font-size: var(--text-base);
      margin-bottom: var(--space-2);
    }

    .highlight-card p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin: 0;
    }

    @media (max-width: 768px) {
      .bio-grid {
        grid-template-columns: 1fr;
      }

      .bio-highlights {
        grid-template-columns: 1fr;
      }
    }

    /* APPROACH */
    .approach-grid {
      gap: clamp(24px, 4vw, 48px);
    }

    .about-cta {
      background-color: #0f0f1a;
      background-image: radial-gradient(circle at 50% 0%, rgba(255, 215, 0, 0.10), transparent 40%);
    }

    .approach-card {
      padding: var(--space-8);
      text-align: center;
    }

    .approach-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border: var(--outline-weight) solid var(--color-accent);
      background: var(--color-primary);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
    }

    .approach-card:hover .approach-icon {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: rotate(-3deg) scale(1.05);
      transition: all var(--transition-base);
    }

    .approach-card h3 {
      font-size: var(--text-lg);
      margin-bottom: var(--space-2);
    }

    .approach-card p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      margin: 0;
    }

    /* ROSTER */
    .roster-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .roster-column h3 {
      font-size: var(--text-lg);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 2px solid var(--color-accent);
      display: inline-block;
    }

    .roster-list {
      list-style: none;
    }

    .roster-list li {
      margin-bottom: var(--space-2);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      padding-left: var(--space-6);
      position: relative;
    }

    .roster-list li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    @media (max-width: 768px) {
      .roster-grid {
        grid-template-columns: 1fr;
      }
    }

    /* DWBEATBEAST */
    .dwbeatbeast-panel {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
      padding: var(--space-12);
    }

    .dwbeatbeast-label {
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-gold);
      display: block;
      margin-bottom: var(--space-4);
    }

    .dwbeatbeast-content h2 {
      margin-bottom: var(--space-4);
    }

    .dwbeatbeast-content p {
      color: var(--color-text-muted);
      margin-bottom: var(--space-6);
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    /* CTA */
    .cta-section {
      background: var(--color-surface);
    }

    .cta-panel {
      max-width: 700px;
      margin: 0 auto;
      text-align: center;
      padding: var(--space-16);
    }

    .cta-title {
      margin-bottom: var(--space-4);
    }

    .cta-text {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
      margin-bottom: var(--space-8);
      max-width: 100%;
    }

    .cta-actions {
      display: flex;
      gap: var(--space-4);
      justify-content: center;
      flex-wrap: wrap;
    }

    @media (max-width: 640px) {
      .cta-panel {
        padding: var(--space-10);
      }
    }

    /* ABOUT HERO - Background image with text overlay */
    .section-hero {
      position: relative;
      overflow: hidden;
      background-image: url('/images/dubbz-about-hero.png');
      background-size: cover;
      background-position: center right;
      padding: clamp(140px, 18vw, 260px) 0 clamp(80px, 10vw, 140px);
    }

    /* COLOR CHANGING BAR */
    .hero-color-bar {
      height: 6px;
      width: 90%;
      margin: 0 auto;
      max-width: 1280px;
      border-radius: 0 0 4px 4px;
      background: linear-gradient(
        90deg,
        var(--color-accent) 0%,
        var(--color-gold) 50%,
        var(--color-accent) 100%
      );
      background-size: 200% 100%;
      animation: color-shift 6s linear infinite;
    }

    @keyframes color-shift {
      0% { background-position: 0% 0; }
      100% { background-position: 200% 0; }
    }

  /* FAQ Styles */
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-4);
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-item {
    background: var(--color-surface);
    border: var(--outline-weight) solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
  }

  .faq-item summary {
    padding: var(--space-5);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    color: var(--color-white);
    list-style: none;
    position: relative;
    padding-right: var(--space-10);
    transition: color var(--transition-fast);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: var(--space-5);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-item[open] summary {
    color: var(--color-accent);
  }

  .faq-item p {
    padding: 0 var(--space-5) var(--space-5);
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     CTA SECTION
  @media (max-width: 640px) {
      .cta-panel {
        padding: var(--space-10);
      }
    }
  }
</style>
</BaseLayout>