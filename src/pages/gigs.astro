---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Gigs & Events — You Know Me As Dubbz" description="Check out upcoming performances and past highlights. Catch You Know Me As Dubbz live at clubs, weddings, corporate events, and FLAVAR Call Collect.">
  <Header />

  <main id="main-content">
    <section class="section section-hero">
      <div class="container">
        <header class="page-header">
          <h1 class="page-title">Gigs & Events</h1>
          <p class="page-description">Catch You Know Me As Dubbz live. From weekly residencies to the monthly FLAVAR Call Collect series, corporate events, and private weddings.</p>
        </header>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="gig-filters" id="gig-filters">
          <button class="filter-btn active" data-filter="upcoming">Upcoming</button>
          <button class="filter-btn" data-filter="past">Past Events</button>
          <button class="filter-btn" data-filter="residencies">Residencies</button>
          <button class="filter-btn" data-filter="flavar">FLAVAR Call Collect</button>
        </div>

        <div class="gigs-list" id="gigs-list">
          <!-- Populated by JS -->
        </div>

        <div class="load-more-container">
          <button class="btn btn-secondary" id="load-more-gigs">Load More</button>
        </div>
      </div>
    </section>

    <!-- Residency Info -->
    <section class="section section-alt" aria-labelledby="residencies-title">
      <div class="container">
        <h2 id="residencies-title" class="section-title">Current Residencies</h2>
        <div class="residencies-grid grid grid-2">
          <article class="residency-card card">
            <div class="residency-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
              </svg>
            </div>
            <h3>Avacado Cantina</h3>
            <p class="residency-detail"><strong>Saturdays, 8-11 PM</strong></p>
            <p class="residency-detail">Palm Beach Gardens, FL</p>
            <p class="residency-desc">Weekly residency — house, top 40, latin, afrobeats. Dancing, great cocktails, high energy.</p>
            <a href="/gigs?filter=residencies" class="btn btn-secondary">View Dates</a>
          </article>
          <article class="residency-card card">
            <div class="residency-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </div>
            <h3>FLAVAR Call Collect</h3>
            <p class="residency-detail"><strong>Monthly Sundays, 3 PM - Close</strong></p>
            <p class="residency-detail">French Grille, Northwood Village, WPB</p>
            <p class="residency-desc">Monthly Sunday day party — afrobeats, dancehall, hip-hop, house. 80-220+ attendees.</p>
            <a href="/gigs?filter=flavar" class="btn btn-secondary">View Dates</a>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .section-hero {
      padding: var(--space-20) 0 var(--space-12);
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
    }

    .page-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }

    .gig-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      justify-content: center;
      margin-bottom: var(--space-10);
    }

    .filter-btn {
      padding: var(--space-2) var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-1);
      font-family: var(--font-display);
      font-size: var(--text-sm);
      color: var(--color-text);
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-white);
    }

    .gigs-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .gig-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      align-items: center;
      padding: var(--space-5);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-4);
      transition: border-color var(--transition-fast), transform var(--transition-fast);
    }

    .gig-card:hover {
      border-color: var(--color-accent);
      transform: translateX(4px);
    }

    .gig-card.hidden {
      display: none;
    }

    .gig-date {
      text-align: center;
      padding: var(--space-4) var(--space-5);
      background: var(--color-accent);
      color: var(--color-white);
      border-radius: var(--space-3);
      min-width: 90px;
    }

    .gig-day {
      font-family: var(--font-display);
      font-size: var(--text-4xl);
      line-height: 1;
    }

    .gig-month {
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .gig-info h3 {
      font-size: var(--text-xl);
      margin-bottom: var(--space-2);
    }

    .gig-venue {
      color: var(--color-text-muted);
      font-size: var(--text-base);
      margin-bottom: var(--space-1);
    }

    .gig-location {
      font-size: var(--text-sm);
      color: var(--color-gray-500);
    }

    .gig-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-top: var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .gig-meta span {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .gig-status {
      padding: var(--space-1) var(--space-3);
      border-radius: var(--space-1);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .gig-status.actual { background: #22c55e; color: var(--color-white); }
    .gig-status.booked { background: #3b82f6; color: var(--color-white); }
    .gig-status.expected { background: #eab308; color: var(--color-primary); }
    .gig-status.pipeline { background: var(--color-gray-700); color: var(--color-white); }

    .residencies-grid {
      gap: var(--space-6);
    }

    .residency-card {
      padding: var(--space-8);
      text-align: center;
    }

    .residency-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--color-accent);
      color: var(--color-white);
      margin-bottom: var(--space-4);
    }

    .residency-card h3 {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-3);
    }

    .residency-detail {
      font-size: var(--text-base);
      color: var(--color-text-muted);
      margin-bottom: var(--space-1);
    }

    .residency-desc {
      margin-top: var(--space-4);
      font-size: var(--text-sm);
    }

    @media (max-width: 768px) {
      .gig-card {
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
      }

      .gig-date {
        grid-row: 1 / 3;
      }

      .gig-status {
        grid-column: 2;
      }

      .gig-filters {
        overflow-x: auto;
        justify-content: flex-start;
        padding-bottom: var(--space-2);
      }

      .filter-btn {
        white-space: nowrap;
        flex-shrink: 0;
      }
    }
  </style>

  <script is:inline>
    let allGigs = [];
    let currentFilter = 'upcoming';
    let visibleCount = 10;
    const PER_PAGE = 10;

    async function loadGigs() {
      try {
        const res = await fetch('/api/gigs?limit=50');
        allGigs = await res.json();
        renderGigs();
      } catch (e) {
        console.log('Gig API not ready, using static fallbacks');
        loadStaticGigs();
      }
    }

