---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Gigs & Events — You Know Me As Dubbz" description="Catch You Know Me As Dubbz live. Upcoming performances, weekly residencies, monthly FLAVAR Call Collect series, and past event highlights.">
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- PAGE HERO -->
    <section class="section section-hero">
      <div class="container">
        <header class="page-header">
          <span class="page-greeting">CATCH ME LIVE</span>
          <h1 class="page-title">Gigs & Events</h1>
          <p class="page-description">From weekly residencies to the monthly FLAVAR Call Collect series, corporate events, and private weddings. See where the energy is next.</p>
        </header>
      </div>
    </section>

    <!-- GIGS FILTERS & LIST -->
    <section class="section">
      <div class="container">
        <div class="gig-filters" id="gig-filters" role="tablist" aria-label="Filter events">
          <button class="filter-btn active" data-filter="upcoming" role="tab" aria-selected="true">Upcoming</button>
          <button class="filter-btn" data-filter="past" role="tab" aria-selected="false">Past Events</button>
          <button class="filter-btn" data-filter="residencies" role="tab" aria-selected="false">Residencies</button>
          <button class="filter-btn" data-filter="flavar" role="tab" aria-selected="false">FLAVAR Call Collect</button>
        </div>

        <div class="gigs-list" id="gigs-list" role="list">
          <!-- Populated by JS -->
        </div>

        <div class="load-more-container">
          <button class="btn btn-secondary" id="load-more-gigs">Load More</button>
        </div>
      </div>
    </section>

    <!-- RESIDENCY INFO -->
    <section class="section section-alt" aria-labelledby="residencies-title">
      <div class="container">
        <header class="section-header">
          <h2 id="residencies-title" class="section-title">Current Residencies</h2>
        </header>
        <div class="residencies-grid grid grid-2">
          <article class="residency-card panel">
            <div class="residency-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
              </svg>
            </div>
            <h3>Avacado Cantina</h3>
            <p class="residency-detail"><strong>Saturdays, 8-11 PM</strong></p>
            <p class="residency-detail">Palm Beach Gardens, FL</p>
            <p class="residency-desc">Weekly residency — house, top 40, latin, afrobeats. Dancing, great cocktails, high energy.</p>
            <a href="/gigs?filter=residencies" class="btn btn-secondary">View Dates</a>
          </article>
          <article class="residency-card panel">
            <div class="residency-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
            </div>
            <h3>FLAVAR Call Collect</h3>
            <p class="residency-detail"><strong>Monthly Sundays, 3 PM - Close</strong></p>
            <p class="residency-detail">French Grille, Northwood Village, WPB</p>
            <p class="residency-desc">Monthly Sunday day party — afrobeats, dancehall, hip-hop, house. 80-220+ attendees.</p>
            <a href="/gigs?filter=flavar" class="btn btn-secondary">View Dates</a>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-panel panel">
          <h2 class="cta-title">Booking a Venue?</h2>
          <p class="cta-text">Bring the Dubbz energy to your club, bar, or event series. Residency and guest spots available.</p>
          <a href="/contact" class="btn btn-primary btn-lg">Discuss a Residency</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .section-hero {
      padding: clamp(120px, 14vw, 176px) 0 clamp(56px, 7vw, 96px);
      background:
        radial-gradient(circle at 78% 22%, rgba(0, 212, 255, 0.14), transparent 36%),
        var(--color-surface);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .page-header {
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }

    .page-greeting {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      display: block;
      margin-bottom: var(--space-4);
    }

    .page-title {
      margin-bottom: var(--space-4);
    }

    .page-description {
      font-size: var(--text-lg);
      color: var(--color-text-muted);
    }

    .gig-filters {
      display: flex;
      flex-wrap: nowrap;
      gap: var(--space-2);
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: var(--space-2);
      margin-bottom: clamp(40px, 5vw, 64px);
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }

    .gig-filters::-webkit-scrollbar {
      height: 4px;
    }

    .gig-filters::-webkit-scrollbar-thumb {
      background: var(--color-border);
      border-radius: 4px;
    }

    .gig-filters .filter-btn {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .filter-btn {
      padding: var(--space-2) var(--space-5);
      background: var(--color-primary);
      border: var(--outline-weight) solid var(--color-border);
      font-family: var(--font-display);
      font-size: var(--text-sm);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-text);
      cursor: pointer;
      transition: all var(--transition-fast);
      position: relative;
    }

    .filter-btn::before {
      content: '';
      position: absolute;
      inset: calc(var(--outline-weight) * -1);
      border: var(--outline-weight) solid transparent;
      transition: border-color var(--transition-fast);
      pointer-events: none;
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-primary);
    }

    .filter-btn:hover::before,
    .filter-btn.active::before {
      border-color: var(--color-accent);
    }

    .filter-btn:focus-visible {
      outline: var(--outline-weight) solid var(--color-accent);
      outline-offset: 3px;
    }

    /* GIG CARD - Neo-brutalist */
    .gigs-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .gig-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      align-items: center;
      padding: var(--space-6);
      background: var(--color-surface);
      border: var(--outline-weight) solid var(--color-border);
      transition: all var(--transition-base);
      position: relative;
      role: listitem;
    }

    .gig-card::before {
      content: '';
      position: absolute;
      inset: calc(var(--outline-weight) * -2);
      border: var(--outline-weight) solid transparent;
      pointer-events: none;
      transition: border-color var(--transition-base);
      z-index: -1;
    }

    .gig-card:hover {
      transform: translateX(-6px);
      box-shadow: var(--outline-weight) var(--outline-weight) 0 var(--color-border),
                  calc(var(--outline-weight) * 2) calc(var(--outline-weight) * 2) 0 var(--color-accent);
    }

    .gig-card:hover::before {
      border-color: var(--color-accent);
    }

    .gig-card.hidden {
      display: none;
    }

    .gig-date {
      text-align: center;
      padding: var(--space-4) var(--space-5);
      background: var(--color-primary);
      border: 2px solid var(--color-accent);
      min-width: 80px;
    }

    .gig-day {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      color: var(--color-accent);
      line-height: 1;
    }

    .gig-month {
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }

    .gig-info h3 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      margin-bottom: var(--space-1);
    }

    .gig-venue {
      color: var(--color-accent);
      font-weight: 500;
      margin-bottom: var(--space-1);
    }

    .gig-location {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .gig-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-top: var(--space-3);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .gig-meta span {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .gig-time {
      font-size: 0.85rem;
      color: var(--color-accent);
      font-weight: 600;
    }

    .gig-actions {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }

    .btn-calendar {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-2) var(--space-3);
      font-size: 0.75rem;
      border: 1px solid var(--color-border);
      background: var(--color-primary);
      color: var(--color-text);
      border-radius: 6px;
      cursor: pointer;
      transition: all var(--transition-fast);
    }

    .btn-calendar:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .btn-calendar svg {
      width: 14px;
      height: 14px;
    }

    .gig-status {
      padding: var(--space-2) var(--space-4);
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      white-space: nowrap;
      border: 2px solid;
    }

    .gig-status.actual { background: #22c55e; color: var(--color-white); border-color: #22c55e; }
    .gig-status.booked { background: #3b82f6; color: var(--color-white); border-color: #3b82f6; }
    .gig-status.expected { background: #eab308; color: var(--color-primary); border-color: #eab308; }
    .gig-status.pipeline { background: var(--color-gray-700); color: var(--color-white); border-color: var(--color-gray-700); }

    .residencies-grid {
      gap: var(--space-6);
    }

    .residency-card {
      padding: var(--space-8);
      text-align: center;
    }

    .residency-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border: var(--outline-weight) solid var(--color-accent);
      background: var(--color-primary);
      color: var(--color-accent);
      margin-bottom: var(--space-4);
    }

    .residency-card:hover .residency-icon {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: rotate(-3deg) scale(1.05);
      transition: all var(--transition-base);
    }

    .residency-card h3 {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-3);
    }

    .residency-detail {
      font-size: var(--text-base);
      color: var(--color-text-muted);
      margin-bottom: var(--space-1);
    }

    .residency-desc {
      margin-top: var(--space-4);
      font-size: var(--text-sm);
    }

    @media (max-width: 768px) {
      .residencies-grid {
        grid-template-columns: 1fr;
      }

      .residency-card {
        padding: var(--space-6);
      }

      .gig-card {
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
        gap: var(--space-4);
      }

      .gig-date {
        grid-row: 1 / 3;
      }

      .gig-status {
        grid-column: 2;
      }
    }

    @media (max-width: 480px) {
      .gig-filters {
        gap: var(--space-1);
      }

      .gig-filters .filter-btn {
        padding: var(--space-1) var(--space-3);
        font-size: 0.72rem;
      }

      .gig-card {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .gig-date {
        margin: 0 auto;
      }

      .gig-status {
        grid-column: 1;
        margin: 0 auto;
      }
    }
  </style>

  <script is:inline>
    let allGigs = [];
    let currentFilter = 'upcoming';
    let visibleCount = 10;
    const PER_PAGE = 10;

    async function loadGigs() {
      try {
        const res = await fetch('/api/gigs.json?limit=50');
        if (res.ok) {
          allGigs = await res.json();
        } else {
          throw new Error('API not ready');
        }
      } catch (e) {
        console.log('Gig API not ready, using static fallbacks');
        loadStaticGigs();
        return;
      }
      renderGigs();
    }

