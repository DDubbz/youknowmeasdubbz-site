---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const mixes = (await getCollection('mixes')).filter(mix => mix.data.published !== false);
const absoluteUrl = (value: string) => /^https?:\/\//.test(value) ? value : `https://youknowmeasdubbz.com${value.startsWith('/') ? value : `/${value}`}`;
const mixSchema = {
  '@context': 'https://schema.org',
  '@graph': mixes.map(mix => ({
    '@type': ['AudioObject', 'MusicRecording'],
    '@id': `https://youknowmeasdubbz.com/mixes/#${mix.id}`,
    name: mix.data.title,
    description: mix.data.description,
    datePublished: mix.data.date.toISOString().slice(0, 10),
    genre: mix.data.genre,
    ...(mix.data.duration ? { duration: mix.data.duration } : {}),
    ...(mix.data.audioFile ? { contentUrl: absoluteUrl(mix.data.audioFile) } : {}),
    thumbnailUrl: absoluteUrl(mix.data.coverImage),
    byArtist: { '@id': 'https://youknowmeasdubbz.com/#business' },
    publisher: { '@id': 'https://youknowmeasdubbz.com/#business' },
    mainEntityOfPage: 'https://youknowmeasdubbz.com/mixes/'
  }))
};
---

<BaseLayout title="Mixes — You Know Me As Dubbz" description="Discover a dynamic collection of music mixes and DJ sets from You Know Me As Dubbz. House, hip-hop, afrobeats, dancehall, latin, and open-format sets.">
  <Header />

  <main id="main-content">
    <div class="bg-pattern" aria-hidden="true"></div>

    <!-- PAGE HERO -->
    <section class="section-hero mixes-hero">
      <div class="container">
        <header class="page-header">
          <span class="page-greeting">The Dubbz Sound</span>
          <h1 class="page-title">Mixes</h1>
          <p class="page-description">Live energy, clean transitions, and open-format selections built for real rooms. Start with the latest set or filter the playlist by your sound.</p>
          <div class="mixes-hero-meta" aria-label="Mix collection highlights">
            <span><strong data-total-mixes>04</strong> curated sets</span>
            <span><strong>06</strong> genre lanes</span>
            <span><strong>100%</strong> Dubbz energy</span>
          </div>
        </header>
      </div>
    </section>

    <!-- PLAYLIST PLAYER -->
    <section class="section-player" aria-labelledby="player-title">
      <div class="container">
        <div class="mixes-studio">
          <div class="playlist-player" id="playlist-player">
            <div class="player-main">
              <audio data-audio preload="metadata" crossorigin="anonymous"></audio>
              <div class="player-artwork">
                <img class="player-artwork-image" src="/mixes/cultural-council-open-format.webp" alt="Current mix cover" data-player-artwork width="1200" height="1200" />
                <div class="player-artwork-shade" aria-hidden="true"></div>
                <span class="player-artwork-label">Now spinning</span>
              </div>

              <div class="player-console">
                <div class="player-track-info">
                  <span class="player-eyebrow">Now Playing</span>
                  <span class="player-track-title" data-track-title>Select a mix to play</span>
                  <span class="player-track-subtitle" data-track-subtitle></span>
                </div>

                <div class="player-timeline">
                  <div class="player-progress" role="slider" aria-label="Playback progress" tabindex="0" data-progress-bar>
                    <div class="player-progress-fill" data-progress-fill></div>
                  </div>
                  <div class="player-time">
                    <span class="player-current" data-current-time>0:00</span>
                    <span class="player-duration" data-duration>0:00</span>
                  </div>
                </div>

                <div class="player-controls-row">
                  <button class="player-control-btn" type="button" data-shuffle-btn aria-label="Shuffle" aria-pressed="false" title="Shuffle (S)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"/><path d="M4 20h9.5"/><polyline points="4 17 9 17 9 12"/><path d="M20 4h-9.5"/><polyline points="20 7 15 7 15 12"/></svg>
                  </button>
                  <button class="player-control-btn" type="button" data-previous-btn aria-label="Previous mix" title="Previous mix (P)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6V5zm3.5 7L19 5v14l-9.5-7z"/></svg>
                  </button>
                  <button class="player-play-btn" type="button" data-play-btn aria-label="Play" disabled>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                  <button class="player-control-btn" type="button" data-next-btn aria-label="Next mix" title="Next mix (N)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2V5zM5 5l9.5 7L5 19V5z"/></svg>
                  </button>
                  <button class="player-control-btn" type="button" data-repeat-btn aria-label="Repeat off" aria-pressed="false" title="Repeat (R)">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                  </button>
                  <div class="player-volume" data-volume-control>
                    <button class="player-volume-btn" type="button" data-mute-btn aria-label="Mute" title="Mute (M)">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-volume-high><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-volume-low style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/></svg>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" data-volume-muted style="display:none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                    </button>
                    <input type="range" class="player-volume-slider" min="0" max="1" step="0.05" value="1" data-volume-slider aria-label="Volume">
                  </div>
                </div>

                <div class="equalizer-bars" aria-hidden="true" data-equalizer-bars>
                  {Array.from({ length: 80 }, (_, i) => (
                    <span style={`--bar-height: ${8 + (i * 13 % 22)}px; --bar-duration: ${700 + (i * 137 % 800)}ms; --bar-delay: -${i * 83}ms;`} />
                  ))}
                </div>
                <p class="player-shortcuts">Space play · P/N tracks · S shuffle · R repeat · M mute · arrows seek/volume</p>
              </div>
            </div>

            <div class="playlist-sidebar">
              <div class="playlist-toolbar">
                <div>
                  <span class="playlist-kicker">Browse the library</span>
                  <h2 id="player-title" class="playlist-title">Playlist</h2>
                </div>
                <span class="playlist-count" data-playlist-count>0 mixes</span>
              </div>
              <div class="playlist-filters" role="tablist" aria-label="Filter playlist by genre">
                <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">All</button>
                <button class="filter-btn" data-filter="house" role="tab" aria-selected="false">House</button>
                <button class="filter-btn" data-filter="hip-hop" role="tab" aria-selected="false">Hip-Hop</button>
                <button class="filter-btn" data-filter="afrobeats" role="tab" aria-selected="false">Afrobeats</button>
                <button class="filter-btn" data-filter="dancehall" role="tab" aria-selected="false">Dancehall</button>
                <button class="filter-btn" data-filter="latin" role="tab" aria-selected="false">Latin</button>
                <button class="filter-btn" data-filter="open-format" role="tab" aria-selected="false">Open Format</button>
              </div>
              <div class="playlist-tracks" id="playlist-tracks" role="listbox" aria-label="Available mixes">
                <!-- Populated by JS -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-panel panel">
          <div class="cta-copy">
            <span class="cta-kicker">Take the sound with you</span>
            <h2 class="cta-title">Want a Custom Mix?</h2>
            <p class="cta-text">Book Dubbz for your event and get a personalized recording of your night.</p>
          </div>
          <a href="/contact" class="btn btn-primary btn-lg">Inquire About Booking</a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(mixSchema)} />
  <Footer />

  <style is:global>
    #main-content {
      overflow: clip;
    }

    .mixes-hero {
      position: relative;
      min-height: 520px;
      padding: clamp(136px, 14vw, 176px) 0 clamp(64px, 8vw, 96px);
      border-bottom: var(--outline-weight) solid var(--color-border);
      background:
        radial-gradient(circle at 86% 30%, rgba(0, 212, 255, 0.16), transparent 34%),
        linear-gradient(135deg, var(--color-primary) 0%, var(--color-surface) 100%);
    }

    .mixes-hero::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 4px;
      background: linear-gradient(90deg, var(--color-accent), var(--color-success), var(--color-warning));
    }

    .page-header {
      max-width: 980px;
    }

    .page-greeting,
    .playlist-kicker,
    .player-eyebrow,
    .cta-kicker {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-sm);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-accent);
    }

    .page-greeting {
      margin-bottom: var(--space-3);
    }

    .page-title {
      margin: 0 0 var(--space-4);
      font-size: clamp(5.5rem, 11vw, 10rem);
      line-height: 0.82;
      letter-spacing: -0.025em;
    }

    .page-description {
      max-width: 720px;
      margin: 0;
      font-size: clamp(1rem, 1.4vw, 1.25rem);
      line-height: 1.75;
      color: var(--color-text-muted);
    }

    .mixes-hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-8);
    }

    .mixes-hero-meta span {
      display: inline-flex;
      align-items: baseline;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      border: 1px solid var(--color-border);
      background: rgba(15, 15, 26, 0.58);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--color-text-muted);
    }

    .mixes-hero-meta strong {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      color: var(--color-white);
    }

    .section-player {
      position: relative;
      padding: clamp(56px, 7vw, 88px) 0 clamp(88px, 10vw, 136px);
      background:
        radial-gradient(circle at 8% 40%, rgba(255, 215, 0, 0.06), transparent 28%),
        var(--color-primary);
    }

    .mixes-studio {
      position: relative;
    }

    .mixes-studio::before {
      content: 'DUBBZ MIX ROOM';
      display: block;
      margin-bottom: var(--space-4);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.16em;
      color: var(--color-text-muted);
    }

    .playlist-player {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(340px, 0.65fr);
      gap: clamp(20px, 2.5vw, 36px);
      align-items: start;
    }

    .player-main {
      position: relative;
      display: grid;
      grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
      min-width: 0;
      overflow: hidden;
      background: linear-gradient(145deg, var(--color-surface), rgba(20, 30, 44, 0.96));
      border: var(--outline-weight) solid var(--color-border);
      box-shadow: 12px 12px 0 rgba(0, 212, 255, 0.08);
    }

    .player-main audio {
      display: none;
    }

    .player-artwork {
      position: relative;
      min-width: 0;
      min-height: 100%;
      overflow: hidden;
      background: var(--color-primary);
      border-right: var(--outline-weight) solid var(--color-border);
    }

    .player-artwork img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 500ms ease;
    }

    .player-artwork-image {
      animation: artwork-pan 20s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
      will-change: object-position;
    }

    @keyframes artwork-pan {
      0%, 10% {
        object-position: left center;
      }
      90%, 100% {
        object-position: right center;
      }
    }

    .player-main:hover .player-artwork img {
      transform: scale(1.025);
    }

    .player-artwork-shade {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, transparent 50%, rgba(15, 15, 26, 0.82));
      pointer-events: none;
    }

    .player-artwork-label {
      position: absolute;
      left: var(--space-4);
      bottom: var(--space-4);
      padding: var(--space-1) var(--space-3);
      background: var(--color-accent);
      color: var(--color-primary);
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .player-console {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 100%;
      padding: clamp(24px, 3vw, 40px);
    }

    .player-track-info {
      min-width: 0;
      margin-bottom: auto;
      padding-bottom: var(--space-8);
    }

    .player-eyebrow {
      margin-bottom: var(--space-3);
    }

    .player-track-title {
      display: -webkit-box;
      overflow: hidden;
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.5rem);
      line-height: 1.05;
      color: var(--color-white);
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .player-track-subtitle {
      display: -webkit-box;
      margin-top: var(--space-3);
      overflow: hidden;
      font-size: var(--text-sm);
      line-height: 1.55;
      color: var(--color-text-muted);
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .player-timeline {
      margin-bottom: var(--space-5);
    }

    .player-progress {
      position: relative;
      height: 8px;
      background: var(--color-primary);
      border: 1px solid var(--color-border);
      cursor: pointer;
      touch-action: none;
    }

    .player-progress::after {
      content: '';
      position: absolute;
      inset: -12px 0;
    }

    .player-progress:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 4px;
    }

    .player-progress-fill {
      width: 0%;
      height: 100%;
      background: linear-gradient(90deg, var(--color-accent), var(--color-success));
      transition: width 100ms linear;
    }

    .player-time {
      display: flex;
      justify-content: space-between;
      margin-top: var(--space-2);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .player-controls-row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-width: 0;
    }

    .player-play-btn,
    .player-control-btn,
    .player-volume-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      border-radius: 50%;
      cursor: pointer;
      transition: transform var(--transition-fast), background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }

    .player-play-btn {
      width: 60px;
      height: 60px;
      background: var(--color-accent);
      border: var(--outline-weight) solid var(--color-primary);
      color: var(--color-primary);
      box-shadow: 0 0 0 1px var(--color-accent);
    }

    .player-play-btn svg {
      margin-left: 3px;
    }

    .player-play-btn:not(:disabled):hover {
      transform: scale(1.05);
      box-shadow: 0 0 26px rgba(0, 212, 255, 0.45);
    }

    .player-play-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .player-control-btn,
    .player-volume-btn {
      width: 44px;
      height: 44px;
      background: var(--color-primary);
      border: 2px solid var(--color-border);
      color: var(--color-text);
    }

    .player-volume-btn {
      width: 40px;
      height: 40px;
    }

    .player-control-btn:hover,
    .player-control-btn[aria-pressed='true'],
    .player-volume-btn:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-primary);
    }

    .player-control-btn:focus-visible,
    .player-volume-btn:focus-visible,
    .player-play-btn:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 3px;
    }

    .player-volume {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      min-width: 116px;
      max-width: 170px;
      margin-left: auto;
    }

    .player-volume-slider {
      width: 100%;
      height: 4px;
      appearance: none;
      background: var(--color-border);
      cursor: pointer;
    }

    .player-volume-slider::-webkit-slider-thumb {
      width: 14px;
      height: 14px;
      appearance: none;
      border-radius: 50%;
      border: 2px solid var(--color-primary);
      background: var(--color-accent);
    }

    .player-volume-slider::-moz-range-thumb {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      border: 2px solid var(--color-primary);
      background: var(--color-accent);
    }

    .equalizer-bars {
      display: flex;
      align-items: flex-end;
      gap: 2px;
      height: 36px;
      margin-top: var(--space-6);
      overflow: hidden;
      opacity: 0.82;
    }

    .equalizer-bars span {
      flex: 1;
      min-width: 1px;
      min-height: 4px;
      background: linear-gradient(180deg, var(--color-accent), var(--color-success));
      transform-origin: bottom;
      animation: eq-dance var(--bar-duration) ease-in-out infinite alternate;
      animation-delay: var(--bar-delay);
    }

    @keyframes eq-dance {
      from { height: 4px; }
      to { height: var(--bar-height); }
    }

    .player-shortcuts {
      margin: var(--space-3) 0 0;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.5;
      color: var(--color-text-muted);
    }

    .playlist-sidebar {
      position: sticky;
      top: 104px;
      min-width: 0;
      max-height: 700px;
      overflow: hidden;
      background: var(--color-surface);
      border: var(--outline-weight) solid var(--color-border);
    }

    .playlist-toolbar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-6) var(--space-6) var(--space-5);
      border-bottom: var(--outline-weight) solid var(--color-border);
    }

    .playlist-kicker {
      margin-bottom: var(--space-1);
      font-size: 0.68rem;
    }

    .playlist-title {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.35rem);
      line-height: 1;
    }

    .playlist-count {
      padding: var(--space-1) var(--space-2);
      border: 1px solid var(--color-border);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      white-space: nowrap;
      color: var(--color-text-muted);
    }

    .playlist-filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      padding: var(--space-4) var(--space-6);
      border-bottom: 1px solid var(--color-border);
    }

    .filter-btn {
      min-height: 32px;
      padding: var(--space-1) var(--space-3);
      border: 1px solid var(--color-border);
      background: var(--color-primary);
      font-family: var(--font-display);
      font-size: var(--text-xs);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-text);
      cursor: pointer;
      transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    }

    .filter-btn:hover,
    .filter-btn.active {
      border-color: var(--color-accent);
      background: var(--color-accent);
      color: var(--color-primary);
    }

    .playlist-tracks {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      max-height: 526px;
      padding: var(--space-4);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-color: var(--color-accent) var(--color-primary);
      scrollbar-width: thin;
    }

    .playlist-track {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr) 40px;
      align-items: center;
      gap: var(--space-3);
      min-width: 0;
      padding: var(--space-3);
      border: 2px solid transparent;
      background: var(--color-primary);
      cursor: pointer;
      transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    }

    .playlist-track:hover {
      border-color: var(--color-border);
      background: rgba(0, 212, 255, 0.06);
      transform: translateX(-3px);
    }

    .playlist-track.playing,
    .playlist-track[aria-selected='true'] {
      border-color: var(--color-accent);
      background: var(--color-accent-dim);
      box-shadow: inset 4px 0 0 var(--color-accent);
    }

    .playlist-track-cover {
      width: 64px;
      height: 64px;
      overflow: hidden;
      background: var(--color-surface);
    }

    .playlist-track-cover img,
    .playlist-track-cover svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .playlist-track-info {
      min-width: 0;
    }

    .playlist-track-title {
      display: -webkit-box;
      overflow: hidden;
      font-family: var(--font-display);
      font-size: var(--text-sm);
      line-height: 1.18;
      color: var(--color-white);
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .playlist-track-meta {
