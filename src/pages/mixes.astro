    @media (prefers-reduced-motion: reduce) {
      .player-artwork-image {
        animation: none;
        object-position: center;
      }

      .equalizer-bars span {
        animation: none;
        height: var(--bar-height);
      }

      .player-main:hover .player-artwork img,
      .playlist-track:hover {
        transform: none;
      }
    }
  </style>

  <script is:inline>
    // Playlist Player with Reactive Equalizer + Volume + Shuffle + Repeat + Keyboard + Persistence
    (() => {
      const player = document.getElementById('playlist-player');
      if (!player) return;

      const audio = player.querySelector('[data-audio]');

      const playBtn = player.querySelector('[data-play-btn]');
      const progressBar = player.querySelector('[data-progress-bar]');
      const progressFill = player.querySelector('[data-progress-fill]');
      const currentTimeEl = player.querySelector('[data-current-time]');
      const durationEl = player.querySelector('[data-duration]');
      const trackTitle = player.querySelector('[data-track-title]');
      const trackSubtitle = player.querySelector('[data-track-subtitle]');
      const eqBars = player.querySelector('[data-equalizer-bars]');
      const playerArtwork = player.querySelector('[data-player-artwork]');
      const playlistTracks = player.querySelector('#playlist-tracks');
      const playlistCount = player.querySelector('[data-playlist-count]');
      const totalMixes = document.querySelector('[data-total-mixes]');
      const filterBtns = player.querySelectorAll('.filter-btn');
      const shuffleBtn = player.querySelector('[data-shuffle-btn]');
      const repeatBtn = player.querySelector('[data-repeat-btn]');
      const previousBtn = player.querySelector('[data-previous-btn]');
      const nextBtn = player.querySelector('[data-next-btn]');
      const muteBtn = player.querySelector('[data-mute-btn]');
      const volumeSlider = player.querySelector('[data-volume-slider]');
      const volumeControl = player.querySelector('[data-volume-control]');

      let audioCtx = null;
      let analyser = null;
      let source = null;
      let animationId = null;
      let isPlaying = false;
      let isPaused = false;
      let allMixes = [];
      let currentFilter = 'all';
      let currentMixId = null;
      let shuffleMode = false;
      let repeatMode = 'off'; // 'off', 'one', 'all'
      let filteredOrder = [];
      const MediaHost = 'https://media.youknowmeasdubbz.com';
      const coverSrc = mix => mix.coverImage && mix.coverImage.startsWith('/')
        ? mix.coverImage
        : `${MediaHost}/${String(mix.coverImage || '').replace(/^\//, '')}`;
      const normalizeMixId = value => String(value || '').replace(/\.md$/, '');

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const STORAGE_KEY = 'dubbz-player-state';

      // --- Persistence ---
      function loadState() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            const state = JSON.parse(saved);
            if (state.volume !== undefined) {
              audio.volume = state.volume;
              volumeSlider.value = state.volume;
              updateVolumeUI(state.volume);
            }
            if (state.shuffleMode !== undefined) {
              shuffleMode = state.shuffleMode;
              shuffleBtn.setAttribute('aria-pressed', String(shuffleMode));
              shuffleBtn.classList.toggle('active', shuffleMode);
            }
            if (state.repeatMode !== undefined) {
              repeatMode = state.repeatMode;
              updateRepeatUI();
            }
            if (state.currentFilter !== undefined) {
              currentFilter = state.currentFilter;
              filterBtns.forEach(btn => {
                const isActive = btn.dataset.filter === currentFilter;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-selected', isActive);
              });
            }
          }
        } catch (e) {
          console.warn('Failed to load player state:', e);
        }
      }

      function saveState() {
        try {
          const state = {
            volume: audio.volume,
            shuffleMode,
            repeatMode,
            currentFilter
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {
          console.warn('Failed to save player state:', e);
        }
      }

      function formatTime(seconds) {
        if (isNaN(seconds) || !isFinite(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
      }

      function updateProgress() {
        const pct = (audio.currentTime / audio.duration) * 100 || 0;
        progressFill.style.width = `${pct}%`;
        currentTimeEl.textContent = formatTime(audio.currentTime);
      }

      function updateDuration() {
        durationEl.textContent = formatTime(audio.duration);
      }

      function setTrackInfo(title, subtitle) {
        trackTitle.textContent = title;
        trackSubtitle.textContent = subtitle;
      }

      function initAudioContext() {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.8;
        source = audioCtx.createMediaElementSource(audio);
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
      }

      function startVisualizer() {
        if (prefersReducedMotion || !analyser) return;
        const dataArray = new Uint8Array(analyser.frequencyBinCount);
        const bars = eqBars.querySelectorAll('span');
        const barCount = bars.length;

        function render() {
          if (!isPlaying || !analyser) {
            animationId = null;
            return;
          }
          analyser.getByteFrequencyData(dataArray);
          const step = Math.ceil(dataArray.length / barCount);
          bars.forEach((bar, i) => {
            const idx = Math.min(i * step, dataArray.length - 1);
            const value = dataArray[idx] / 255;
            const height = 8 + value * 24;
            bar.style.height = `${height}px`;
          });
          animationId = requestAnimationFrame(render);
        }
        render();
      }

      function stopVisualizer() {
        if (animationId) cancelAnimationFrame(animationId);
        animationId = null;
        if (!prefersReducedMotion) {
          eqBars.querySelectorAll('span').forEach(bar => {
            bar.style.height = '';
          });
        }
      }

      function updateVolumeUI(vol) {
        const highIcon = muteBtn.querySelector('[data-volume-high]');
        const lowIcon = muteBtn.querySelector('[data-volume-low]');
        const mutedIcon = muteBtn.querySelector('[data-volume-muted]');
        const wasMuted = audio.muted;

        if (vol === 0 || wasMuted) {
          highIcon.style.display = 'none';
          lowIcon.style.display = 'none';
          mutedIcon.style.display = 'block';
          muteBtn.setAttribute('aria-label', 'Unmute');
          volumeControl.classList.add('muted');
        } else if (vol < 0.5) {
          highIcon.style.display = 'none';
          lowIcon.style.display = 'block';
          mutedIcon.style.display = 'none';
          muteBtn.setAttribute('aria-label', 'Mute');
          volumeControl.classList.remove('muted');
        } else {
          highIcon.style.display = 'block';
          lowIcon.style.display = 'none';
          mutedIcon.style.display = 'none';
          muteBtn.setAttribute('aria-label', 'Mute');
          volumeControl.classList.remove('muted');
        }
        volumeSlider.value = vol;
      }

      function updateRepeatUI() {
        const icons = {
          off: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>',
          one: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/><text x="12" y="17" font-size="8" text-anchor="middle" fill="currentColor">1</text></svg>',
          all: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>'
        };
        repeatBtn.innerHTML = icons[repeatMode];
        repeatBtn.setAttribute('aria-label', `Repeat ${repeatMode === 'off' ? 'off' : repeatMode}`);
        repeatBtn.setAttribute('aria-pressed', String(repeatMode !== 'off'));
        repeatBtn.classList.toggle('active', repeatMode !== 'off');
        repeatBtn.title = `Repeat (R) — ${repeatMode === 'off' ? 'Off' : repeatMode === 'one' ? 'One' : 'All'}`;
      }

      function updateShuffleUI() {
        shuffleBtn.setAttribute('aria-pressed', String(shuffleMode));
        shuffleBtn.classList.toggle('active', shuffleMode);
        shuffleBtn.title = `Shuffle (S) — ${shuffleMode ? 'On' : 'Off'}`;
      }

      function getFilteredMixes() {
        const filtered = currentFilter === 'all'
          ? allMixes
          : allMixes.filter(m => m.genre?.includes(currentFilter));

        if (shuffleMode && filtered.length > 1) {
          // Create a deterministic shuffle based on a seed
          if (!filteredOrder.length || filteredOrder.length !== filtered.length) {
            filteredOrder = [...filtered].sort(() => Math.random() - 0.5);
          }
          return filteredOrder;
        } else {
          filteredOrder = [];
          return filtered;
        }
      }

      function play() {
        if (!audio.src) return;
        if (!audioCtx) initAudioContext();
        audio.play().then(() => {
          isPlaying = true;
          isPaused = false;
          playBtn.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
          playBtn.setAttribute('aria-label', 'Pause');
          startVisualizer();
          updatePlayingTrackUI();
        }).catch(err => console.warn('Play failed:', err));
      }

      function pause() {
        audio.pause();
        isPlaying = false;
        isPaused = true;
        playBtn.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
        playBtn.setAttribute('aria-label', 'Play');
        stopVisualizer();
        updatePlayingTrackUI();
      }

      function togglePlay() {
        if (isPlaying) pause();
        else play();
      }

      function loadMix(mix, shouldPlay = true) {
        if (!mix.audioFile) return;
        const audioUrl = `${MediaHost}${mix.audioFile}`;
        audio.src = audioUrl;
        setTrackInfo(mix.title, mix.description || 'DJ Mix');
        if (mix.coverImage) {
          playerArtwork.src = coverSrc(mix);
          playerArtwork.alt = `${mix.title} cover`;
        }
        playBtn.disabled = false;
        currentMixId = mix.id;

        audio.addEventListener('loadedmetadata', updateDuration, { once: true });
        audio.addEventListener('ended', onEnded, { once: true });

        updatePlayingTrackUI();
        if (shouldPlay) play();
      }

      function onEnded() {
        isPlaying = false;
        playBtn.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
        playBtn.setAttribute('aria-label', 'Play');
        stopVisualizer();
        updateProgress();
        updatePlayingTrackUI();

        handleNext();
      }

      function handleNext() {
        const filtered = getFilteredMixes();
        const currentIndex = filtered.findIndex(m => m.id === currentMixId);

        if (repeatMode === 'one') {
          // Repeat current track
          loadMix(allMixes.find(m => m.id === currentMixId));
          return;
        }

        if (currentIndex >= 0 && currentIndex < filtered.length - 1) {
          loadMix(filtered[currentIndex + 1]);
        } else if (repeatMode === 'all' && filtered.length > 0) {
          // Loop to first
          loadMix(filtered[0]);
        }
      }

      function skipTrack(direction) {
        const filtered = getFilteredMixes();
        if (!filtered.length) return;

        if (direction < 0 && audio.currentTime > 4) {
          audio.currentTime = 0;
          updateProgress();
          return;
        }

        const currentIndex = filtered.findIndex(m => m.id === currentMixId);
        const baseIndex = currentIndex >= 0 ? currentIndex : 0;
        const targetIndex = (baseIndex + direction + filtered.length) % filtered.length;
        loadMix(filtered[targetIndex]);
      }

      function updatePlayingTrackUI() {
        playlistTracks.querySelectorAll('.playlist-track').forEach(trackEl => {
          const mixId = trackEl.dataset.mix;
          const isCurrent = mixId === currentMixId;
          trackEl.classList.toggle('current', isCurrent);
          trackEl.classList.toggle('playing', isCurrent && isPlaying);
          trackEl.setAttribute('aria-selected', String(isCurrent));
          const playSvg = trackEl.querySelector('.playlist-track-play svg');
          if (playSvg) {
            if (isCurrent && isPlaying) {
              playSvg.outerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>';
            } else {
              playSvg.outerHTML = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
            }
          }
        });
      }

      function renderPlaylist(mixes) {
        if (!playlistTracks) return;

        const filtered = getFilteredMixes();
        if (playlistCount) {
          playlistCount.textContent = `${filtered.length} ${filtered.length === 1 ? 'mix' : 'mixes'}`;
        }

        if (!filtered.length) {
          playlistTracks.innerHTML = `
            <div style="padding: var(--space-8); text-align: center; color: var(--color-text-muted);">
              No mixes found for this filter.
            </div>
          `;
          return;
        }

        playlistTracks.innerHTML = filtered.map((mix, i) => `
          <article class="playlist-track ${mix.id === currentMixId ? 'current' : ''} ${mix.id === currentMixId && isPlaying ? 'playing' : ''}" data-mix="${mix.id}" role="option" aria-selected="${mix.id === currentMixId}">
            <div class="playlist-track-cover">
              ${mix.coverImage
                ? `<img src="${coverSrc(mix)}" alt="" width="1200" height="1200" />`
                : `<img src="/mix-placeholder.svg" alt="" width="1200" height="1200" />`
              }
            </div>
            <div class="playlist-track-info">
              <span class="playlist-track-title">${mix.title}</span>
              <div class="playlist-track-meta">
                ${mix.duration ? `<span>${mix.duration}</span>` : ''}
                ${mix.genre?.slice(0, 2).map(g => `<span class="playlist-track-tag">${g}</span>`).join('') || ''}
              </div>
            </div>
            <button class="playlist-track-play" aria-label="Play ${mix.title}" data-mix="${mix.id}">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </article>
        `).join('');

        playlistTracks.querySelectorAll('.playlist-track').forEach(trackEl => {
          trackEl.addEventListener('click', (e) => {
            const mixId = trackEl.dataset.mix;
            const mix = allMixes.find(m => m.id === mixId);
            if (mix) loadMix(mix);
          });
        });

        playlistTracks.querySelectorAll('.playlist-track-play').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const mixId = btn.dataset.mix;
            const mix = allMixes.find(m => m.id === mixId);
            if (mix) loadMix(mix);
          });
        });
      }

      function filterPlaylist(genre) {
        currentFilter = genre;
        filteredOrder = []; // Reset shuffle order when filter changes
        renderPlaylist(allMixes);
        saveState();

        filterBtns.forEach(btn => {
          const isActive = btn.dataset.filter === genre;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive);
        });
      }

      function seek(e) {
        const rect = progressBar.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        audio.currentTime = pct * audio.duration;
        updateProgress();
      }

      // --- Event listeners ---
      playBtn?.addEventListener('click', togglePlay);
      previousBtn?.addEventListener('click', () => skipTrack(-1));
      nextBtn?.addEventListener('click', () => skipTrack(1));
      progressBar?.addEventListener('click', seek);
      audio.addEventListener('loadedmetadata', updateDuration);
      audio.addEventListener('timeupdate', updateProgress);

      // Volume controls
      muteBtn?.addEventListener('click', () => {
        audio.muted = !audio.muted;
        updateVolumeUI(audio.volume);
        saveState();
      });

      volumeSlider?.addEventListener('input', (e) => {
        const vol = parseFloat(e.target.value);
        audio.volume = vol;
        audio.muted = false;
        updateVolumeUI(vol);
        saveState();
      });

      // Shuffle
      shuffleBtn?.addEventListener('click', () => {
        shuffleMode = !shuffleMode;
        updateShuffleUI();
        filteredOrder = []; // Regenerate shuffle order
        renderPlaylist(allMixes);
        saveState();
      });

      // Repeat
      repeatBtn?.addEventListener('click', () => {
        const modes = ['off', 'all', 'one'];
        const currentIndex = modes.indexOf(repeatMode);
        repeatMode = modes[(currentIndex + 1) % modes.length];
        updateRepeatUI();
        saveState();
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        // Ignore if typing in an input
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return;

        switch (e.key) {
          case ' ':
          case 'k':
            e.preventDefault();
            togglePlay();
            break;
          case 'ArrowRight':
            e.preventDefault();
            audio.currentTime = Math.min(audio.duration, audio.currentTime + (e.shiftKey ? 30 : 5));
            updateProgress();
            break;
          case 'ArrowLeft':
            e.preventDefault();
            audio.currentTime = Math.max(0, audio.currentTime - (e.shiftKey ? 30 : 5));
            updateProgress();
            break;
          case 'ArrowUp':
            e.preventDefault();
            audio.volume = Math.min(1, audio.volume + 0.1);
            audio.muted = false;
            updateVolumeUI(audio.volume);
            saveState();
            break;
          case 'ArrowDown':
            e.preventDefault();
            audio.volume = Math.max(0, audio.volume - 0.1);
            updateVolumeUI(audio.volume);
            saveState();
            break;
          case 'm':
            e.preventDefault();
            audio.muted = !audio.muted;
            updateVolumeUI(audio.volume);
            saveState();
            break;
          case 's':
            e.preventDefault();
            shuffleMode = !shuffleMode;
            updateShuffleUI();
            filteredOrder = [];
            renderPlaylist(allMixes);
            saveState();
            break;
          case 'p':
            e.preventDefault();
            skipTrack(-1);
            break;
          case 'n':
            e.preventDefault();
            skipTrack(1);
            break;
          case 'r':
            e.preventDefault();
            const modes = ['off', 'all', 'one'];
            const currentIndex = modes.indexOf(repeatMode);
            repeatMode = modes[(currentIndex + 1) % modes.length];
            updateRepeatUI();
            saveState();
            break;
          case 'f':
            e.preventDefault();
            // Focus progress bar for seeking
            progressBar?.focus();
            break;
        }
      });

      // Touch handling for progress bar (mobile)
      let touchStartX = 0;
      let touchStartTime = 0;

      progressBar?.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchStartTime = Date.now();
      }, { passive: true });

      progressBar?.addEventListener('touchmove', (e) => {
        e.preventDefault();
        const touchX = e.touches[0].clientX;
        const rect = progressBar.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (touchX - rect.left) / rect.width));
        audio.currentTime = pct * audio.duration;
        updateProgress();
      }, { passive: false });

      progressBar?.addEventListener('touchend', (e) => {
        // Tap to seek (short touch without much movement)
        if (Date.now() - touchStartTime < 200) {
          const rect = progressBar.getBoundingClientRect();
          const pct = Math.max(0, Math.min(1, (touchStartX - rect.left) / rect.width));
          audio.currentTime = pct * audio.duration;
          updateProgress();
        }
      }, { passive: true });

      // Focus-visible for progress bar keyboard seeking
      progressBar?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
          updateProgress();
          e.preventDefault();
        } else if (e.key === 'ArrowLeft') {
          audio.currentTime = Math.max(0, audio.currentTime - 5);
          updateProgress();
          e.preventDefault();
        }
      });

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => filterPlaylist(btn.dataset.filter));
      });

      // Load mixes on init
      async function loadMixes() {
        try {
          const res = await fetch('/api/mixes.json?limit=50', { cache: 'no-store' });
          if (res.ok) {
            allMixes = await res.json();
            if (totalMixes) totalMixes.textContent = String(allMixes.length).padStart(2, '0');
            loadState(); // Load persisted state before rendering
            // Load the first playable mix without forcing autoplay.
            const firstWithAudio = allMixes.find(m => m.audioFile);
            if (firstWithAudio) {
              loadMix(firstWithAudio, false);
            }
            renderPlaylist(allMixes);
          }
        } catch (e) {
          console.error('Failed to load mixes:', e);
        }
      }

      // Handle ?play= query param to auto-load a specific mix
      const urlParams = new URLSearchParams(window.location.search);
      const playParam = urlParams.get('play');
      if (playParam) {
        const checkMixes = setInterval(() => {
          if (allMixes.length > 0) {
            const mix = allMixes.find(m =>
              normalizeMixId(m.id) === normalizeMixId(playParam) ||
              normalizeMixId(m.slug) === normalizeMixId(playParam)
            );
            if (mix) loadMix(mix, false);
            clearInterval(checkMixes);
          }
        }, 100);
        setTimeout(() => clearInterval(checkMixes), 5000);
      }

      document.addEventListener('DOMContentLoaded', loadMixes);
    })();
  </script>
</BaseLayout>