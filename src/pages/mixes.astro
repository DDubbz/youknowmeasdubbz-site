      }
    }

    @media (max-width: 420px) {
      .player-main {
        grid-template-columns: 96px minmax(0, 1fr);
      }

      .player-artwork {
        min-height: 96px;
      }

      .player-console {
        padding: var(--space-3);
      }

      .player-control-btn,
      .player-volume-btn {
