---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
---

<BaseLayout title="You Know Me As Dubbz — South Florida DJ & Event Production" description="Professional DJ services for weddings, corporate events, clubs, and private parties in West Palm Beach, Miami, and South Florida.">
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-content">
          <h1 id="hero-title" class="hero-title animate-fade-in-up">You Know Me As Dubbz</h1>
          <p class="hero-tagline animate-fade-in-up" style="animation-delay: 100ms;">South Florida's Premier DJ Experience</p>
          <div class="hero-cta animate-fade-in-up" style="animation-delay: 200ms;">
            <a href="/contact" class="btn btn-primary btn-lg">Book Your Event</a>
            <a href="/mixes" class="btn btn-secondary btn-lg">Listen to Mixes</a>
          </div>
        </div>
        <div class="hero-visual animate-fade-in-up" style="animation-delay: 300ms;">
          <div class="hero-image-placeholder">
            <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="400" height="300" fill="var(--color-surface)"/>
              <circle cx="200" cy="150" r="60" stroke="var(--color-accent)" stroke-width="2" fill="none"/>
              <circle cx="200" cy="150" r="40" fill="var(--color-accent)"/>
              <circle cx="200" cy="150" r="20" fill="var(--color-primary)"/>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- About Preview -->
    <section class="section" aria-labelledby="about-preview-title">
      <div class="container">
        <header class="section-header">
          <h2 id="about-preview-title" class="section-title">About</h2>
        </header>
        <div class="about-preview grid grid-2">
          <div class="about-text">
            <h3>You Know Me As Dubbz</h3>
            <p>South Florida-based entertainment company providing professional DJ services and event production. Established in 2024, we deliver tailored, high-energy music experiences for corporate events, nightlife venues, and private gatherings.</p>
            <p>With over 10 years of professional experience, the signature sound blends house, hip-hop, afrobeats, dancehall, top 40, and latin — curated for each unique room.</p>
            <a href="/about" class="btn btn-secondary">Learn More</a>
          </div>
          <div class="about-stats">
            <div class="stat-card">
              <span class="stat-number">1000+</span>
              <span class="stat-label">Events Performed</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">10+</span>
              <span class="stat-label">Years Experience</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">50+</span>
              <span class="stat-label">Weddings</span>
            </div>
            <div class="stat-card">
              <span class="stat-number">3</span>
              <span class="stat-label">Brand Identities</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Mixes -->
    <section class="section" aria-labelledby="mixes-title">
      <div class="container">
        <header class="section-header">
          <h2 id="mixes-title" class="section-title">Latest Mixes</h2>
          <a href="/mixes" class="btn btn-secondary">Explore All Mixes</a>
        </header>
        <div class="mixes-grid grid grid-3" id="featured-mixes">
          <!-- Populated by JS -->
        </div>
      </div>
    </section>

    <!-- Upcoming Gigs -->
    <section class="section" aria-labelledby="gigs-title">
      <div class="container">
        <header class="section-header">
          <h2 id="gigs-title" class="section-title">Catch Me Live</h2>
          <a href="/gigs" class="btn btn-secondary">View All Events</a>
        </header>
        <div class="gigs-list" id="upcoming-gigs">
          <!-- Populated by JS -->
        </div>
      </div>
    </section>

    <!-- Services Preview -->
    <section class="section section-alt" aria-labelledby="services-title">
      <div class="container">
        <header class="section-header">
          <h2 id="services-title" class="section-title">Services</h2>
        </header>
        <div class="services-grid grid grid-4">
          <article class="service-card card">
            <div class="service-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 2v20M17 5H7l-2 7h14l-2-7Z"/>
                <path d="M8 21h8"/>
              </svg>
            </div>
            <h3>Weddings & Private Events</h3>
            <p>Tailored playlists, MC services, ceremony-to-reception flow</p>
            <span class="service-price">From $1,500</span>
          </article>
          <article class="service-card card">
            <div class="service-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
              </svg>
            </div>
            <h3>Corporate Events</h3>
            <p>Brand-aligned music programming for conferences, galas, launches</p>
            <span class="service-price">From $2,000</span>
          </article>
          <article class="service-card card">
            <div class="service-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20M12 2v20"/>
              </svg>
            </div>
            <h3>Nightlife & Clubs</h3>
            <p>High-energy sets that keep the dance floor packed</p>
            <span class="service-price">Residency & Guest</span>
          </article>
          <article class="service-card card">
            <div class="service-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M9 18V5l12-2v13"/>
                <circle cx="6" cy="18" r="3"/>
                <circle cx="18" cy="16" r="3"/>
              </svg>
            </div>
            <h3>Music Production</h3>
            <p>Custom beats, remixes, original tracks as DWBEATBEAST</p>
            <span class="service-price">Custom Quote</span>
          </article>
        </div>
        <div class="services-cta">
          <a href="/services" class="btn btn-primary">View All Services</a>
          <a href="/contact" class="btn btn-secondary">Inquire About Booking</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-20) 0;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, var(--color-secondary) 0%, var(--color-primary) 70%);
      z-index: -1;
    }

    .hero .container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
      align-items: center;
    }

    .hero-title {
      font-size: var(--text-5xl);
      line-height: 1;
      margin-bottom: var(--space-6);
      color: var(--color-white);
    }

    .hero-tagline {
      font-size: var(--text-xl);
      color: var(--color-accent);
      font-family: var(--font-display);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: var(--space-8);
    }

    .hero-cta {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
    }

    .btn-lg {
      padding: var(--space-4) var(--space-8);
      font-size: var(--text-lg);
    }

    .hero-visual {
      display: flex;
      justify-content: center;
    }

    .hero-image-placeholder {
      width: 100%;
      max-width: 400px;
      aspect-ratio: 4/3;
      border-radius: var(--space-4);
      overflow: hidden;
      border: 1px solid var(--color-border);
    }

    .hero-image-placeholder svg {
      width: 100%;
      height: 100%;
    }

    @media (max-width: 768px) {
      .hero .container {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-content {
        order: 2;
      }

      .hero-visual {
        order: 1;
      }

      .hero-cta {
        justify-content: center;
      }
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: var(--space-10);
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .about-preview {
      gap: var(--space-12);
      align-items: center;
    }

    .about-text h3 {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-4);
    }

    .about-stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }

    .stat-card {
      text-align: center;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-4);
    }

    .stat-number {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-4xl);
      color: var(--color-accent);
      line-height: 1;
    }

    .stat-label {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }

    .mixes-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    @media (max-width: 1024px) {
      .mixes-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
      .mixes-grid { grid-template-columns: 1fr; }
    }

    .mix-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-4);
      overflow: hidden;
      transition: transform var(--transition-base), box-shadow var(--transition-base);
    }

    .mix-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    }

    .mix-cover {
      aspect-ratio: 1;
      overflow: hidden;
      position: relative;
    }

    .mix-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--transition-slow);
    }

    .mix-card:hover .mix-cover img {
      transform: scale(1.05);
    }

    .mix-play-btn {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity var(--transition-base);
    }

    .mix-card:hover .mix-play-btn {
      opacity: 1;
    }

    .mix-play-btn svg {
      width: 64px;
      height: 64px;
      color: var(--color-white);
      transform: scale(0.8);
      transition: transform var(--transition-base);
    }

    .mix-play-btn:hover svg {
      transform: scale(1);
    }

    .mix-info {
      padding: var(--space-4);
    }

    .mix-title {
      font-size: var(--text-lg);
      margin-bottom: var(--space-1);
    }

    .mix-meta {
      display: flex;
      gap: var(--space-3);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .gigs-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .gig-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
      align-items: center;
      padding: var(--space-4);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--space-4);
      transition: border-color var(--transition-fast);
    }

    .gig-card:hover {
      border-color: var(--color-accent);
    }

    .gig-date {
      text-align: center;
      padding: var(--space-3) var(--space-4);
      background: var(--color-accent);
      color: var(--color-white);
      border-radius: var(--space-3);
      min-width: 80px;
    }

    .gig-day {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      line-height: 1;
    }

    .gig-month {
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .gig-info h3 {
      font-size: var(--text-lg);
      margin-bottom: var(--space-1);
    }

    .gig-venue {
      color: var(--color-text-muted);
      font-size: var(--text-sm);
    }

    .gig-meta {
      display: flex;
      gap: var(--space-3);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
    }

    .gig-status {
      padding: var(--space-1) var(--space-3);
      border-radius: var(--space-1);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
    }

    .gig-status.actual { background: var(--color-green, #22c55e); color: var(--color-white); }
    .gig-status.booked { background: var(--color-blue, #3b82f6); color: var(--color-white); }
    .gig-status.expected { background: var(--color-yellow, #eab308); color: var(--color-primary); }
    .gig-status.pipeline { background: var(--color-gray-700); color: var(--color-white); }

    .services-grid {
      gap: var(--space-6);
    }

    .service-card {
      text-align: center;
      padding: var(--space-8);
    }

    .service-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--color-accent);
      color: var(--color-white);
      margin-bottom: var(--space-4);
    }

    .service-card h3 {
      font-size: var(--text-xl);
      margin-bottom: var(--space-2);
    }

    .service-card p {
      font-size: var(--text-sm);
      margin-bottom: var(--space-4);
    }

    .service-price {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      color: var(--color-accent);
    }

    .services-cta {
      display: flex;
      justify-content: center;
      gap: var(--space-4);
      margin-top: var(--space-8);
    }

    .section-alt {
      background: var(--color-surface);
    }
  </style>

  <script is:inline>
    // Load featured mixes and gigs via fetch
    async function loadFeaturedContent() {
      try {
        const [mixesRes, gigsRes] = await Promise.all([
          fetch('/api/mixes?featured=true&limit=3'),
          fetch('/api/gigs?upcoming=true&limit=3')
        ]);
        const mixes = await mixesRes.json();
        const gigs = await gigsRes.json();

        renderMixes(mixes);
        renderGigs(gigs);
      } catch (e) {
        console.log('Content API not ready, using static fallbacks');
      }
    }

    function renderMixes(mixes) {
      const container = document.getElementById('featured-mixes');
      if (!container || !mixes.length) return;

      container.innerHTML = mixes.map(mix => `
        <article class="mix-card">
          <div class="mix-cover">
            <img src="${mix.coverImage || '/mix-placeholder.jpg'}" alt="${mix.title}" loading="lazy">
            <div class="mix-play-btn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="mix-info">
            <h3 class="mix-title">${mix.title}</h3>
            <div class="mix-meta">
              <span>${mix.genre?.join(', ') || 'Various'}</span>
              <span>${mix.duration || ''}</span>
            </div>
          </div>
        </article>
      `).join('');
    }

    function renderGigs(gigs) {
      const container = document.getElementById('upcoming-gigs');
      if (!container || !gigs.length) return;

      container.innerHTML = gigs.map(gig => `
        <article class="gig-card">
          <div class="gig-date">
            <div class="gig-day">${new Date(gig.date).getDate()}</div>
            <div class="gig-month">${new Date(gig.date).toLocaleString('en-US', { month: 'short' })}</div>
          </div>
          <div class="gig-info">
            <h3>${gig.title}</h3>
            <p class="gig-venue">${gig.venue}${gig.address ? `, ${gig.address}` : ''}</p>
            <div class="gig-meta">
              <span>${gig.startTime}${gig.endTime ? ` - ${gig.endTime}` : ''}</span>
              ${gig.fee ? `<span>$${gig.fee.toLocaleString()}</span>` : ''}
            </div>
          </div>
          <span class="gig-status ${gig.status}">${gig.status}</span>
        </article>
      `).join('');
    }

    loadFeaturedContent();
  </script>
</BaseLayout>